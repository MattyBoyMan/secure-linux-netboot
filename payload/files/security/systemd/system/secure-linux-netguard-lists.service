[Unit]
Description=Secure Linux: download the newest block lists (dangerous sites, trackers)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A failed download keeps the last good copy, but MUST remain a failed service result: the security audit
# distinguishes "installed timer" from "update actually succeeded" and shows the failure to the user.
ExecStart=/usr/local/bin/secure-linux-netguard update-lists
Nice=15
IOSchedulingClass=idle
