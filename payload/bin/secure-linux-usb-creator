    parts = relative.split("/")
    top = parts[0].lower()
    if len(parts) > 1:
        return top not in KIT_TOP_FOLDERS
    return top not in KIT_TOP_FILES and not top.endswith(BOOT_IMAGE_SUFFIXES)
VENTOY_CONFIG = "ventoy/ventoy.json"
