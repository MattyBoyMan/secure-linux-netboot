# Quietly looks for a newer Secure Linux release and, once signed releases are set up (or /etc/secure-linux/kit-update-auto-apply exists), installs it by itself, unless automatic installing is off (secure-linux-kit-update-auto set --auto-apply no); a run by itself skips an update bigger than 500 MB and never shows a message.
[Unit]
Description=Look for a newer Secure Linux release
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/bin/secure-linux-kit-update-auto

[Service]
Type=oneshot
ExecStart=/usr/local/bin/secure-linux-kit-update-auto run
SuccessExitStatus=0
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=15min
