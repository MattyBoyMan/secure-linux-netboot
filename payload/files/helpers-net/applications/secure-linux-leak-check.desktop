[Desktop Entry]
Type=Application
Version=1.0
Name=Has my password leaked?
GenericName=Leaked-password check
Comment=Check a password against known leaks. Only 5 characters of a fingerprint leave this computer.
Exec=/usr/local/bin/secure-linux-leak-check --pause
Icon=dialog-password
Terminal=true
Categories=Utility;Security;
Keywords=password;leak;breach;pwned;safe;
StartupNotify=false
