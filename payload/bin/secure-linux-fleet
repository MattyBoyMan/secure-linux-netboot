#!/bin/bash
# secure-linux-fleet: look after the family's other Secure Linux PCs from this laptop (over SSH).
#   secure-linux-fleet add HOST [NAME]   connect once with the PC's password, then use a key from now on
#                                        (on "lite" PCs password logins are then switched off)
#   secure-linux-fleet list              your PCs
#   secure-linux-fleet status            a table: online?, Fedora version, alerts on each PC
#   secure-linux-fleet upgrade HOST|NAME run the system upgrade on that PC (asks first)
#   secure-linux-fleet remove HOST|NAME  forget a PC
#   secure-linux-fleet pair              show this laptop's pairing words and serve its fleet key
#                                        once over the home network, for secure-linux-fleet-join
#                                        on another PC (run that PC's "Join your home fleet")
# HOST is user@address, e.g. sam@10.0.30.21 or sam@kids-pc.local. Each lite PC also has Cockpit at
# https://<address>:9090 (home network only).
set -u   # no pipefail: "cmd | grep -q" must not fail when grep stops reading early
FLEET=$HOME/.config/secure-linux/fleet       # lines: NAME HOST
KEY=$HOME/.ssh/id_ed25519
SSH_OPTS=(-o ConnectTimeout=8 -o ServerAliveInterval=10)
SL_ROOT=${SL_ROOT:-/usr/local/lib/secure-linux}
[ -f "$SL_ROOT/lib/fleet-pair.sh" ] && . "$SL_ROOT/lib/fleet-pair.sh"
mkdir -p "$(dirname "$FLEET")"; touch "$FLEET"
say() { printf '%s\n' "$*"; }
confirm() {       # confirm "question"   (SL_FLEET_YES=1 answers yes, for tests)
  [ "${SL_FLEET_YES:-}" = 1 ] && return 0
  local a; read -rp "$1 [y/N] " a; case $a in y*|Y*) return 0 ;; *) return 1 ;; esac
}
lookup() {        # NAME or HOST -> HOST
  local h; h=$(awk -v k="$1" '$1==k || $2==k {print $2; exit}' "$FLEET"); echo "${h:-$1}"
}

cmd_add() {
  local host=${1:-} name=${2:-}
  [ -n "$host" ] || { say "Use: secure-linux-fleet add user@address [name]"; return 1; }
  case $host in *@*) ;; *) host="$USER@$host" ;; esac
  name=${name:-$(printf '%s' "${host#*@}" | cut -d. -f1)}
  if [ ! -f "$KEY" ]; then
    say "Creating this laptop's SSH key (a digital ID card; the private half never leaves this laptop)..."
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -N "" -C "$USER@$(hostname 2>/dev/null) secure-linux-fleet" -f "$KEY" || return 1
  fi
  say "Connecting to $host. Type that PC's password when asked (only this once)."
  ssh-copy-id -i "$KEY.pub" "${SSH_OPTS[@]}" "$host" || { say "Couldn't connect. Is the PC on, and on the same network?"; return 1; }
  if ! ssh -o BatchMode=yes "${SSH_OPTS[@]}" "$host" true; then
    say "The key login didn't work, so nothing else was changed."; return 1
  fi
  say "Key login works."
  local profile; profile=$(ssh -o BatchMode=yes "${SSH_OPTS[@]}" "$host" cat /etc/secure-linux/profile 2>/dev/null)
  if [ "$profile" = lite ]; then
    say "This is a 'lite' PC: it accepts SSH logins, so it's safest to switch off password logins now"
    say "(only computers with a key, like this laptop, can then log in remotely)."
    if confirm "Switch off password logins on $host?"; then
      ssh -t "${SSH_OPTS[@]}" "$host" "sudo sh -c 'printf \"# secure-linux-fleet: keys only\\nPasswordAuthentication no\\nKbdInteractiveAuthentication no\\n\" > /etc/ssh/sshd_config.d/40-secure-linux-keys-only.conf && sshd -t && systemctl reload sshd'" \
        && say "Done: $host now only accepts key logins." \
        || say "Couldn't change it (wrong sudo password?). Password logins are still on."
      ssh -o BatchMode=yes "${SSH_OPTS[@]}" "$host" true || say "WARNING: the key login stopped working. Log in at that PC and delete /etc/ssh/sshd_config.d/40-secure-linux-keys-only.conf"
    fi
  fi
  awk -v h="$host" '$2!=h' "$FLEET" > "$FLEET.new"; echo "$name $host" >> "$FLEET.new"; mv "$FLEET.new" "$FLEET"
  say "Added $name ($host). Check on it any time with: secure-linux-fleet status"
}

cmd_list() {
  [ -s "$FLEET" ] || { say "No PCs added yet. Add one with: secure-linux-fleet add user@address"; return 0; }
  awk '{printf "  %-14s %s\n", $1, $2}' "$FLEET"
}

REMOTE_STATUS='v=$(. /etc/os-release 2>/dev/null; echo "$VERSION_ID"); n=0; t="";
for f in /var/lib/secure-linux/alerts.d/*; do [ -f "$f" ] || continue; n=$((n+1)); t="$t$(head -1 "$f"); "; done;
up=$(uptime -p 2>/dev/null | sed "s/^up //"); echo "$v|$n|$up|$t"'
cmd_status() {
  [ -s "$FLEET" ] || { cmd_list; return 0; }
  printf '%-14s %-8s %-7s %-7s %s\n' PC Online Fedora Alerts "What needs attention"
  local name host out v n up t
  while read -r name host; do
    [ -n "$host" ] || continue
    if out=$(ssh -n -o BatchMode=yes "${SSH_OPTS[@]}" "$host" "$REMOTE_STATUS" 2>/dev/null); then
      IFS='|' read -r v n up t <<< "$out"
      printf '%-14s %-8s %-7s %-7s %s\n' "$name" yes "${v:-?}" "${n:-0}" "${t:-all good (up $up)}"
    else
      printf '%-14s %-8s %-7s %-7s %s\n' "$name" no - - "switched off, asleep, or not on this network"
    fi
  done < "$FLEET"
}

cmd_upgrade() {
  local host; host=$(lookup "${1:-}")
  [ -n "$host" ] || { say "Use: secure-linux-fleet upgrade NAME"; return 1; }
  confirm "Run the system upgrade on $host now? It may take a while and the PC may restart." || return 0
  ssh -t "${SSH_OPTS[@]}" "$host" "command -v secure-linux-upgrade >/dev/null && sudo secure-linux-upgrade || echo 'secure-linux-upgrade is not on that PC; run: sudo /usr/local/lib/secure-linux/setup.sh --repair'"
}

cmd_remove() {
  local host; host=$(lookup "${1:-}")
  grep -q " $host\$" "$FLEET" || { say "Not in your list: ${1:-}"; return 1; }
  awk -v h="$host" '$2!=h' "$FLEET" > "$FLEET.new"; mv "$FLEET.new" "$FLEET"
  say "Removed $host from your list. (Its key login still works; to revoke it, delete the line ending in"
  say "'secure-linux-fleet' from ~/.ssh/authorized_keys on that PC.)"
}

cmd_pair() {   # show the pairing words and serve this laptop's fleet key once, on the home network only
  if [ ! -f "$KEY" ]; then
    say "Creating this laptop's SSH key (a digital ID card; the private half never leaves this laptop)..."
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -N "" -C "$USER@$(hostname 2>/dev/null) secure-linux-fleet" -f "$KEY" || return 1
  fi
  say "The six pairing words for this laptop's fleet key (the joining PC must show the SAME words):"
  say ""
  say "      $(fp_words_for_pubkey "$KEY.pub")"
  say ""
  say "  (fingerprint: $(fp_fingerprint "$KEY.pub"))"
  [ "${1:-}" = "--words-only" ] && return 0
  local port ip tmpd
  port=$(fp_pick_port)
  tmpd=$(mktemp -d); cp "$KEY.pub" "$tmpd/id_ed25519.pub"
  # If the fleet server (screen help) is set up here, tell the joining PC where it is and its key
  if [ -s /var/lib/rustdesk-server/id_ed25519.pub ]; then
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
    printf '{"rendezvous":"%s","key":"%s"}\n' "$ip" "$(cat /var/lib/rustdesk-server/id_ed25519.pub)" > "$tmpd/fleet.json"
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --zone=home --add-port="$port/tcp" >/dev/null 2>&1   # runtime only, home zone only
    trap 'firewall-cmd --zone=home --remove-port="'"$port"'/tcp" >/dev/null 2>&1; rm -rf "$tmpd"' EXIT
  else
    trap 'rm -rf "$tmpd"' EXIT
  fi
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
  say ""
  say "On the other PC run:  secure-linux-fleet-join    (choose \"over the home network\")"
  say "and type this address:  ${ip:-<home-network address of this laptop>}:$port"
  say ""
  say "Serving the key ONCE, on the home network only, for up to 5 minutes. Close with Ctrl-C."
  fp_serve_once "$tmpd" "$port" 300
  say "Key served (or timed out) - the door is closed again."
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  list|"") cmd_list ;;
  status) cmd_status ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  pair) shift; cmd_pair "$@" ;;
  -h|--help|help) sed -n '2,13p' "$0" ;;
  *) sed -n '2,13p' "$0"; exit 1 ;;
esac
