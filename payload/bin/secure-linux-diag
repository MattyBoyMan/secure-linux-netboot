#!/bin/bash
# secure-linux-diag: one click -> a diagnostics zip on your Desktop to send to whoever helps you (B8).
# It contains system information and recent error messages. Your user name, the computer name, Wi-Fi names,
# network hardware (MAC) addresses, serial numbers, e-mail addresses and IP addresses are blanked out.
# No passwords or files of yours are included.
#   secure-linux-diag            asks for your password once (some logs need it)
set -u   # no pipefail: "cmd | grep -q" must not fail when grep stops reading early
export LC_ALL=C
case "${1:-}" in -h|--help) sed -n '2,6p' "$0"; exit 0 ;; esac

SL_ROOT=${SL_ROOT:-/usr/local/lib/secure-linux}
# shellcheck source=../lib/common.sh
. "$SL_ROOT/lib/common.sh"
have() { command -v "$1" >/dev/null 2>&1; }

# Self-elevate, remembering who asked so the zip goes on their Desktop
if [ "$(id -u)" -ne 0 ]; then
  echo "Creating a diagnostics file. Your password is needed to read the system logs."
  exec pkexec "$(readlink -f "$0")" --for-user "$(id -un)"
fi
FOR_USER=""
[ "${1:-}" = --for-user ] && FOR_USER=${2:-}
[ -n "$FOR_USER" ] || { [ -n "${PKEXEC_UID:-}" ] && FOR_USER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1); }
[ -n "$FOR_USER" ] || FOR_USER=$(sl_user)
HOME_DIR=$(getent passwd "$FOR_USER" | cut -d: -f6)
DESK=$(sudo -u "$FOR_USER" xdg-user-dir DESKTOP 2>/dev/null); [ -n "$DESK" ] && [ "$DESK" != "$HOME_DIR" ] || DESK="$HOME_DIR/Desktop"
mkdir -p "$DESK"

STAMP=$(date +%Y%m%d-%H%M)
NAME="secure-linux-diagnostics-$STAMP"
WORK=$(mktemp -d); OUT="$WORK/$NAME"; mkdir -p "$OUT"
trap 'rm -rf "$WORK"' EXIT

run() {   # run FILE CMD...   save a command's output (with a header); never fails
  local f=$1; shift
  { echo "### $*"; echo; timeout 120 "$@" 2>&1; echo; } >> "$OUT/$f"
}
echo "Collecting information (about a minute)..."
run system.txt cat /etc/os-release
run system.txt uname -a
run system.txt uptime
have inxi && run system.txt inxi -Fxxz -c0
have fastfetch && run system.txt fastfetch --pipe
run system.txt lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
run system.txt df -h
run system.txt cat /etc/secure-linux/profile
run services.txt systemctl --failed --no-pager
run services.txt systemctl list-timers --all --no-pager
run errors-this-boot.txt bash -c 'journalctl -b -p warning --no-pager | tail -n 4000'
run errors-previous-boot.txt bash -c 'journalctl -b -1 -p warning --no-pager | tail -n 4000'
have ausearch && run selinux-denials.txt ausearch -m avc -ts boot -i
have getenforce && run selinux-denials.txt getenforce
have dnf && run software.txt bash -c 'dnf history list | head -50'
have rpm-ostree && run software.txt rpm-ostree status
have flatpak && run software.txt flatpak list --columns=application,version,origin,installation
have fwupdmgr && run software.txt fwupdmgr get-devices --no-unreported-check
have resolvectl && run network.txt resolvectl status
have nmcli && run network.txt nmcli general status
have nmcli && run network.txt nmcli device status
have firewall-cmd && run network.txt firewall-cmd --list-all
have nordvpn && run network.txt nordvpn status
have secure-linux-dns && run network.txt secure-linux-dns status
have secure-linux-vpn && run network.txt secure-linux-vpn status --short
have secure-linux-zone && run network.txt secure-linux-zone status --short
have secure-linux-status && run secure-linux-status.json secure-linux-status --json
{ for f in "$SL_STATE"/alerts.d/*; do [ -f "$f" ] && { echo "== ${f##*/}"; cat "$f"; echo; }; done; } > "$OUT/alerts.txt" 2>/dev/null
[ -f "$SL_LOGDIR/failures.log" ] && cp "$SL_LOGDIR/failures.log" "$OUT/setup-failures.txt"
[ -f "$SL_LOGDIR/setup.log" ] && tail -n 5000 "$SL_LOGDIR/setup.log" > "$OUT/setup-log.txt"
[ -f "$SL_STATE/checks" ] && cp "$SL_STATE/checks" "$OUT/health-check.txt"
[ -f "$SL_STATE/hwtest.txt" ] && cp "$SL_STATE/hwtest.txt" "$OUT/hardware-test.txt"
# Hardware health report (secure-linux-health) and the parts-mapper state (secure-linux-parts). Redacted below like the rest.
HEALTH_DIR=${SL_HEALTH_DIR:-$SL_STATE/health}
[ -f "$HEALTH_DIR/latest.txt" ] || HEALTH_DIR="$HOME_DIR/.local/state/secure-linux/health"   # a check run by the user alone saves here
for f in latest.txt latest.json; do [ -f "$HEALTH_DIR/$f" ] && cp "$HEALTH_DIR/$f" "$OUT/health-$f"; done
for f in report.txt report.json installed.list seen last-run; do
  [ -f "$SL_STATE/parts/$f" ] || continue
  case $f in *.*) dest=parts-mapper-$f ;; *) dest=parts-mapper-$f.txt ;; esac
  cp "$SL_STATE/parts/$f" "$OUT/$dest"
done
{ for f in "$SL_STATE"/user-alerts/*/*; do [ -f "$f" ] && { echo "== ${f#"$SL_STATE"/user-alerts/}"; cat "$f"; echo; }; done; } >> "$OUT/alerts.txt" 2>/dev/null

# ---------------------------------------------------------------- redaction
HOSTN=$(hostname 2>/dev/null); FULLN=$(getent passwd "$FOR_USER" | cut -d: -f5 | cut -d, -f1)
SECRETS=$(mktemp)
{
  echo "$FOR_USER"; echo "$HOME_DIR"; echo "$HOSTN"; echo "${HOSTN%%.*}"; echo "$FULLN"
  sl_user; sl_build_get HOME_WIFI_SSID; sl_build_get SL_FULLNAME
  have nmcli && nmcli -t -f NAME connection show 2>/dev/null
  have nmcli && nmcli -t -f SSID device wifi list --rescan no 2>/dev/null
} | sed 's/\\:/:/g' | awk 'length($0) >= 3' | sort -u > "$SECRETS"
redact() {   # redact FILE
  local f=$1 s tmp sval='[^ ,;]+'
  tmp=$(mktemp)
  case $f in *.json) sval='[^ ,;"]+'   # keep JSON files valid: the closing quote is not part of the serial
    sed -E -i 's/("[^"]*[Ss]erial[^"]*" *: *)"[^"]*"/\1"<serial>"/g' "$f" 2>/dev/null ;; esac
  # longest first, literal match (escape regex characters)
  awk '{ print length($0) "\t" $0 }' "$SECRETS" | sort -rn | cut -f2- | while IFS= read -r s; do
    s=$(printf '%s' "$s" | sed 's/[][\.*^$/&|]/\\&/g')
    sed -i "s|$s|<redacted>|g" "$f" 2>/dev/null
  done
  sed -E -i \
    -e 's/([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}/<mac>/g' \
    -e "s/([Ss]erial([ _-]?([Nn]umber|[Nn]o))?[^:=]{0,10}[:=] *)$sval/\\1<serial>/g" \
    -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/<email>/g' \
    -e 's/\b(192\.168|10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}\b/<local-ip>/g' \
    "$f"
  # public IPv4 addresses, except well-known DNS servers (useful for support)
  awk '{
    out=""; s=$0
    while (match(s, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) {
      ip=substr(s, RSTART, RLENGTH)
      keep = (ip ~ /^(127\.|0\.0\.0\.0|1\.1\.1\.[12]|1\.0\.0\.[12]|9\.9\.9\.9|149\.112\.112\.112|255\.)/)
      out = out substr(s, 1, RSTART-1) (keep ? ip : "<ip>")
      s = substr(s, RSTART+RLENGTH)
    }
    print out s }' "$f" > "$tmp" && cat "$tmp" > "$f"
  rm -f "$tmp"
}
for f in "$OUT"/*; do redact "$f"; done
rm -f "$SECRETS"

cat > "$OUT/README.txt" <<EOF
SECURE LINUX DIAGNOSTICS ($(date '+%Y-%m-%d %H:%M'))

This zip helps someone work out what's wrong with this computer. It contains:
  system.txt                  hardware and Fedora version (inxi, fastfetch), disks and free space
  services.txt                background services that stopped, and scheduled tasks
  errors-this-boot.txt        warnings and errors since the last start
  errors-previous-boot.txt    warnings and errors from the start before that
  selinux-denials.txt         actions the SELinux security layer blocked
  software.txt                recent software changes, Flatpak apps, firmware devices
  network.txt                 DNS, network and firewall status (no Wi-Fi passwords)
  alerts.txt, health-check.txt  what the Secure Linux health check found
  hardware-test.txt           results of the hardware test (if it was run)
  health-latest.txt, health-latest.json   the latest hardware health check (drive wear, memory, battery, fans...)
  parts-mapper-*.txt, .json   which programs your hardware needs and which are installed
  secure-linux-status.json    the same, in machine-readable form
  setup-log.txt, setup-failures.txt  what happened during setup

What is NOT in it: no passwords, no Wi-Fi keys, no personal files, no browser data.
Blanked out: your user name and full name, the computer name, Wi-Fi network names,
hardware (MAC) addresses, serial numbers, e-mail addresses and IP addresses.
You can open every file and read it before sending it.
EOF

ZIP="$DESK/$NAME.zip"
if have zip; then
  (cd "$WORK" && zip -qr "$ZIP" "$NAME")
else
  ZIP="$DESK/$NAME.tar.gz"
  tar -C "$WORK" -czf "$ZIP" "$NAME"
fi
chown "$FOR_USER:" "$ZIP" 2>/dev/null; chmod 0644 "$ZIP"
echo
echo "Done. The diagnostics file is on your Desktop:"
echo "  $(basename "$ZIP")"
echo "Send it to whoever is helping you. It contains no passwords."
sl_user_run notify-send -a "Secure Linux" -i help-about "Diagnostics file ready" "$(basename "$ZIP") is on your Desktop. It contains no passwords." >/dev/null 2>&1
exit 0
