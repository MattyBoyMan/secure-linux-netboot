NOT_FOR_SOMEONE_ELSE = ("Make the drive for yourself (--personal mine), or make a new drive for them with the drive "
                        "maker on another computer.")
DRIVE_TEST_TOOL = "secure-linux-drive-test"         # contract C6 (P11)
FIXER_TOOL = "secure-linux-usb-fixer"
TEMPLATE_CHANGED_WARNING = (
    "Note: the kit's installer has changed since this saved master was made. Drives made from this master install "
    "fine but miss the newest installer steps. Re-make the master from a new drive to get them."
)
# The kit's own pure-Python SHA-512 crypt hasher (tests/sha512crypt.py, byte for byte; a test keeps them identical).
# The account step writes it into the installer, because the installer's Python has no crypt module.
SHA512CRYPT_PY = r'''"""Pure-Python SHA-512 crypt ($6$), written from Ulrich Drepper's specification
(https://www.akkadia.org/drepper/SHA-crypt.txt). Used only to cross-check the
openssl hash that make-usb.ps1 produces. Python 3.13 removed the crypt module.

    python sha512crypt.py PASSWORD SALT [ROUNDS]
"""
import hashlib
import sys

B64 = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"


def _b64_from_24bit(b2, b1, b0, n):
    w = (b2 << 16) | (b1 << 8) | b0
    out = ""
    for _ in range(n):
        out += B64[w & 0x3F]
        w >>= 6
    return out


def sha512_crypt(password: bytes, salt: bytes, rounds: int = 5000) -> str:
    custom_rounds = rounds != 5000
    rounds = max(1000, min(rounds, 999999999))
    salt = salt[:16]
    pl, sl = len(password), len(salt)

    b = hashlib.sha512(password + salt + password).digest()
    a = hashlib.sha512(password + salt)
    n = pl
    while n > 64:
        a.update(b)
        n -= 64
    a.update(b[:n])
    n = pl
    while n > 0:
        a.update(b if n & 1 else password)
        n >>= 1
    a = a.digest()

    dp = hashlib.sha512(password * pl).digest()
    p = (dp * (pl // 64 + 1))[:pl]
    ds = hashlib.sha512(salt * (16 + a[0])).digest()
    s = (ds * (sl // 64 + 1))[:sl]

    c = a
    for i in range(rounds):
        h = hashlib.sha512()
        h.update(p if i & 1 else c)
        if i % 3:
            h.update(s)
        if i % 7:
            h.update(p)
        h.update(c if i & 1 else p)
        c = h.digest()

    order = [(0, 21, 42), (22, 43, 1), (44, 2, 23), (3, 24, 45), (25, 46, 4), (47, 5, 26),
             (6, 27, 48), (28, 49, 7), (50, 8, 29), (9, 30, 51), (31, 52, 10), (53, 11, 32),
             (12, 33, 54), (34, 55, 13), (56, 14, 35), (15, 36, 57), (37, 58, 16), (59, 17, 38),
             (18, 39, 60), (40, 61, 19), (62, 20, 41)]
    enc = "".join(_b64_from_24bit(c[x], c[y], c[z], 4) for x, y, z in order)
    enc += _b64_from_24bit(0, 0, c[63], 2)
    prefix = "$6$" + (f"rounds={rounds}$" if custom_rounds else "")
    return prefix + salt.decode("ascii") + "$" + enc


def _selftest():
    # Test vectors from the specification
    vectors = [
        (b"Hello world!", b"saltstring", 5000,
         "$6$saltstring$svn8UoSVapNtMuq1ukKS4tPQd8iKwSMHWjl/O817G3uBnIFNjnQJuesI68u4OTLiBFdcbYEdFCoEOfaS35inz1"),
        (b"Hello world!", b"saltstringsaltstring", 10000,
         "$6$rounds=10000$saltstringsaltst$OW1/O6BYHV6BcXZu8QVeXbDWra3Oeqh0sbHbbMCVNSnCM/UrjmM0Dp8vOuZeHBy/YTBmSK6H9qs/y3RnOaw5v."),
    ]
    for pw, salt, rounds, want in vectors:
        got = sha512_crypt(pw, salt, rounds)
        assert got == want, (got, want)


if __name__ == "__main__":
    _selftest()
    r = int(sys.argv[3]) if len(sys.argv) > 3 else 5000
    print(sha512_crypt(sys.argv[1].encode("utf-8"), sys.argv[2].encode("ascii"), r))'''


def release_date(release_id):
    match = RELEASE_DATE_RE.fullmatch(str(release_id or ""))
    return match.group(1) if match else None


def payload_bytes(root, entry):
    """A saved master file's bytes, checked against its manifest hash once more."""
    data = (Path(root) / "payload" / entry["path"]).read_bytes()
    if len(data) != entry["size"] or sha256_bytes(data) != entry["sha256"]:
        raise VerificationError(f"saved master file failed SHA-256: {entry['path']}")
    return data


# ---- Installer template: every value the drive maker filled in, read back ----------------------------------------

def render_installer(template, values):
    """Fill every __NAME__ of the template in one pass. A name without a value stops the job; nothing is guessed."""
    missing = sorted({name for name in PLACEHOLDER_RE.findall(template) if name not in values})
    if missing:
        raise CreatorError("the installer template has a value this drive builder does not know: " + ", ".join(missing))
    return PLACEHOLDER_RE.sub(lambda match: values[match.group(0)], template)


def unrender_installer(template, rendered):
    """The value the drive maker put in for each __NAME__ of the template, or None when the two do not fit.

    The template's own text must appear in order; every repeated name must have the same value; and filling the
    template with the values found must give back the installer exactly, byte for byte.
    """
    literals = PLACEHOLDER_RE.split(template)
    names = PLACEHOLDER_RE.findall(template)
    if not names or not rendered.startswith(literals[0]):
        return None
    position = len(literals[0])
    values = {}
    for index, name in enumerate(names):
        after = literals[index + 1]
        if name in values:
            end = position + len(values[name])
            if rendered[position:end] != values[name]:
                return None
        elif index == len(names) - 1:
            end = len(rendered) - len(after)
            if end < position:
                return None
        elif not after:
            return None                    # two names side by side cannot be told apart
        else:
            end = rendered.find(after, position)
            if end < 0:
                return None
        values.setdefault(name, rendered[position:end])
        if rendered[end:end + len(after)] != after:
            return None
        position = end + len(after)
    if position != len(rendered):
        return None
    try:
        if render_installer(template, values) != rendered:
            return None
    except CreatorError:
        return None
    return values


def installer_template_candidates(root, by_path):
    """The template this drive was made from (kept in the master), then the kit's own one beside this tool."""
    candidates = []
    entry = by_path.get(MASTER_TEMPLATE_PATH)
    if entry:
        candidates.append(("the saved master", payload_bytes(root, entry)))
    if _REPOSITORY_ROOT is not None:
        path = _REPOSITORY_ROOT / "templates" / "fedora.ks"
        if path.is_file() and not path.is_symlink():
            candidates.append(("this kit", path.read_bytes()))
    return candidates


def ks_quote(text):
    """make-usb.ps1's Ks-Quote: a Kickstart double-quoted string."""
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def asked_account_template(template):
    """The installer template with the network installer's "your login" step (P10b) and its user-name places."""
    sys.dont_write_bytecode = True
    try:
        from ks_account_step import AccountStepError, apply_account_step
    except ImportError as exc:
        raise CreatorError("the account step (linux/lib/ks_account_step.py) is missing beside this tool, so a drive "
                           "that asks for the name and password cannot be made. " + NOT_FOR_SOMEONE_ELSE) from exc
    try:
        text = apply_account_step(template)
    except AccountStepError as exc:
        raise CreatorError("this saved master's installer is too old to ask for a name and password ("
                           f"{exc}). " + NOT_FOR_SOMEONE_ELSE) from exc
    for old, new in ASKED_ACCOUNT_SUBSTITUTIONS:
        if text.count(old) != 1:
            raise CreatorError("this saved master's installer does not have the user-name lines this drive builder "
                               "knows, so it cannot ask for a login safely. " + NOT_FOR_SOMEONE_ELSE)
        text = text.replace(old, new)
    for line in SHA512CRYPT_PY.split("\n"):
        if line.startswith("%") or line == "SHA512CRYPT_END":
            raise CreatorError("the password hasher has a line that would break the installer script")
    return text


def installer_for_someone_else(choice, owner_text, candidates, person):
    """(new installer text, the values the drive maker had filled in for the owner)."""
    for _, raw in candidates:
        try:
            template = raw.decode("utf-8").replace("\r\n", "\n")
        except UnicodeDecodeError:
            continue
        found = unrender_installer(template, owner_text)
        if found is None and re.search(r"(?m)^SL_SEALED=yes$", owner_text):
            # P19: a locked installer fits the locked template (linux/lib/usbc_seal.py sealed_template)
            sys.dont_write_bytecode = True
            try:
                from usbc_seal import sealed_template
            except ImportError:
                sealed_template = None
            locked = sealed_template(template) if sealed_template else None
            found = unrender_installer(locked, owner_text) if locked else None
            if found is not None:
                found = dict(found)
                found.pop("__SHA512CRYPT_PY__", None)
        if found is None:
            continue
        values = dict(found)
        values.update(PERSONAL_PLACEHOLDER_BLANKS)
        if choice == "none":
            text = asked_account_template(template)
            for name in ACCOUNT_PLACEHOLDERS:
                values.pop(name, None)
            values["__SHA512CRYPT_PY__"] = SHA512CRYPT_PY
        else:
            text = template
            values.update({"__USERNAME__": person["SL_USER"], "__FULLNAME__": ks_quote(person["SL_FULLNAME"]),
                           "__PASSWORD_HASH__": person["PASSWORD_HASH"]})
        return render_installer(text, values), found
    raise CreatorError("this saved master's installer script cannot be matched with the installer template it was "
                       "made from, so its owner's settings cannot be taken out safely. Nothing was written. "
                       + NOT_FOR_SOMEONE_ELSE)


# ---- build.conf, packed blocks, Debian files ------------------------------------------------------------------------

def build_conf_for(text, choice, person=None, never_online=False):
    """build.conf for this drive. "mine" keeps every line (only KIT_UPDATE_ONLINE changes when asked)."""
    lines = text.replace("\r\n", "\n").split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if choice == "mine":
        if not never_online:
            return text
        kept = [line for line in lines if not (BUILD_LINE_RE.match(line)
                                               and BUILD_LINE_RE.match(line).group(1) == "KIT_UPDATE_ONLINE")]
        return "\n".join(kept + ["KIT_UPDATE_ONLINE=no"]) + "\n"
    output = [SOMEONE_ELSE_BUILD_HEADER]
    seen = set()
    for line in lines:
        match = BUILD_LINE_RE.match(line)
        if not match:
            continue                       # comments may hold anything, so none is carried over
        key = match.group(1)
        if key in seen:
            continue
        if key in NON_PERSONAL_BUILD_KEYS:
            output.append(line)
            seen.add(key)
        elif key in EMPTIED_BUILD_KEYS:
            output.append(key + "=")
            seen.add(key)
    if choice == "other":
        for key, value in (("SL_USER", person["SL_USER"]), ("SL_FULLNAME", person["SL_FULLNAME"])):
            if key in seen:
                output[output.index(key + "=")] = key + "=" + value
            else:
                output.append(key + "=" + value)
    if never_online:
        output.append("KIT_UPDATE_ONLINE=no")
    return "\n".join(output) + "\n"


def build_conf_values(text):
    values = {}
    for line in text.replace("\r\n", "\n").split("\n"):
        match = BUILD_LINE_RE.match(line)
        if match:
            values.setdefault(match.group(1), match.group(2).strip())
    return values


def tar_key(name):
    return (name[2:] if name.startswith("./") else name).rstrip("/")


def read_tar_members(data, what):
    """[(TarInfo, bytes or None for a folder)] in archive order. Links, special files and unsafe paths stop the job."""
    import zlib
    members = []
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as archive:
            for member in archive.getmembers():
                parts = tar_key(member.name).split("/")
                if member.name.startswith("/") or "\\" in member.name or ".." in parts:
                    raise CreatorError(f"{what} contains an unsafe path, so it was left unchanged")
                if member.isdir():
                    members.append((member, None))
                elif member.isfile():
                    handle = archive.extractfile(member)
                    members.append((member, handle.read() if handle else b""))
                else:
                    raise CreatorError(f"{what} contains a link or special file, so it was left unchanged")
    except (tarfile.TarError, OSError, EOFError, zlib.error) as exc:
        raise CreatorError(f"{what} could not be read: {exc}") from exc
    return members


def write_tar_members(members):
    """The same names, kinds and permissions, packed the same way every time (no dates, no owners)."""
    packed = io.BytesIO()
    with gzip.GzipFile(fileobj=packed, mode="wb", mtime=0) as zipped:
        with tarfile.open(fileobj=zipped, mode="w", format=tarfile.GNU_FORMAT) as archive:
            for member, data in members:
                info = tarfile.TarInfo(member.name)
                info.mtime = 0
                info.uid = info.gid = 0
                info.uname = info.gname = "root"
                info.mode = (member.mode & 0o777) or (0o755 if data is None else 0o644)
                if data is None:
                    info.type = tarfile.DIRTYPE
                    archive.addfile(info)
                else:
                    info.size = len(data)
                    archive.addfile(info, io.BytesIO(data))
    return packed.getvalue()


def packed_block_span(ks_bytes):
    if ks_bytes.count(KS_PAYLOAD_BEGIN) != 1:
        raise CreatorError("the installer script has no single packed Secure Linux block, so it was left unchanged")
    start = ks_bytes.index(KS_PAYLOAD_BEGIN) + len(KS_PAYLOAD_BEGIN)
    end = ks_bytes.find(KS_PAYLOAD_END, start)
    if end < 0:
        raise CreatorError("the installer script's packed Secure Linux block has no end marker, so it was left unchanged")
    return start, end


def packed_block_members(ks_bytes):
    start, end = packed_block_span(ks_bytes)
    try:
        archive = base64.b64decode(ks_bytes[start:end], validate=False)
    except ValueError as exc:
        raise CreatorError("the installer script's packed Secure Linux block is not valid base64") from exc
    return read_tar_members(archive, "the installer script's packed Secure Linux block")


def rewrite_packed_build_conf(ks_bytes, choice, person, never_online):
    """The installer script with build.conf inside its packed block made for this drive; every other byte stays."""
    start, end = packed_block_span(ks_bytes)
    members = packed_block_members(ks_bytes)
    changed = False
    rebuilt = []
    for member, data in members:
        if data is not None and tar_key(member.name) == "build.conf":
            new = build_conf_for(data.decode("utf-8", "replace"), choice, person, never_online).encode("utf-8")
            changed = changed or new != data
            data = new
        rebuilt.append((member, data))
    if not changed:
        return ks_bytes
    encoded = base64.b64encode(write_tar_members(rebuilt))
    wrapped = b"\n".join(encoded[index:index + 76] for index in range(0, len(encoded), 76))
    return ks_bytes[:start] + wrapped + ks_bytes[end:]


def preseed_for(text, choice, person):
    """A Debian answer file: the login and name lines are left out ("none", so the installer asks) or set from the
    person file ("other")."""
    counts = {PRESEED_USER: 0, PRESEED_FULLNAME: 0}
    output = []
    for line in text.replace("\r\n", "\n").split("\n"):
        prefix = next((key for key in counts if line.startswith(key)), None)
        if prefix is None:
            if not (choice == "none" and line == PRESEED_BUILDER_NOTE):
                output.append(line)
            continue
        counts[prefix] += 1
        if choice == "other":
            value = person["SL_USER"] if prefix == PRESEED_USER else re.sub(r"[\r\n$\\]", "", person["SL_FULLNAME"])
            output.append(prefix + value)
    if any(count != 1 for count in counts.values()):
        raise CreatorError("a Debian answer file on this master does not have exactly one login line and one name line, "
                           "so it cannot be changed safely. Nothing was written. " + NOT_FOR_SOMEONE_ELSE)
    return "\n".join(output)


def debian_archive_for(data, choice, person, never_online, what):
    members = read_tar_members(data, what)
    rebuilt = []
    for member, body in members:
        key = tar_key(member.name)
        if body is not None and choice != "mine" and key in DEBIAN_PERSONAL_MEMBERS:
            continue
        if body is not None and key == DEBIAN_BUILD_CONF_MEMBER:
            body = build_conf_for(body.decode("utf-8", "replace"), choice, person, never_online).encode("utf-8")
        rebuilt.append((member, body))
    return write_tar_members(rebuilt)


# ---- The boot menu shows the release ---------------------------------------------------------------------------------

def _json_string_tokens(text, key):
    """(start, end, decoded value) of every "key": "..." string in raw JSON text."""
    tokens = []
    for match in re.finditer(r'"' + re.escape(key) + r'"\s*:\s*"((?:[^"\\]|\\.)*)"', text):
        try:
            tokens.append((match.start(1), match.end(1), json.loads('"' + match.group(1) + '"')))
        except ValueError:
            continue
    return tokens


def label_boot_menu(raw, release_id):
    """ventoy.json with "Release YYYY.MM.DD" once in the main entry's tip (or its title when it has no tip).

    Only those characters change; every other byte stays as it was. Without a main entry the file is left alone.
    """
    date = release_date(release_id)
    if not date:
        return raw
    try:
        text = raw.decode("utf-8")
        config = json.loads(text)
    except (UnicodeDecodeError, ValueError):
        return raw
    if not isinstance(config, dict):
        return raw
    label = "Release " + date
    main = None
    for item in config.get("auto_install") or []:
        if isinstance(item, dict) and any(str(name).endswith("/" + KS_PAYLOAD_PATH.split("/")[-1])
                                          for name in (item.get("template") or [])):
            main = item.get("image")
            break
    tips = (config.get("menu_tip") or {}).get("tips") if isinstance(config.get("menu_tip"), dict) else None
    aliases = config.get("menu_alias") if isinstance(config.get("menu_alias"), list) else []
    if main is None and aliases and isinstance(aliases[0], dict):
        main = aliases[0].get("image")
    if main is None:
        return raw
    for key, entries, old_label, add in (
            ("tip", tips or [], OLD_TIP_LABEL_RE, lambda token: label + ". " + token),
            ("alias", aliases, OLD_ALIAS_LABEL_RE, lambda token: token + " - " + label)):
        wanted = [entry.get(key) for entry in entries if isinstance(entry, dict) and entry.get("image") == main]
        if len(wanted) != 1 or not isinstance(wanted[0], str):
            continue
        tokens = [token for token in _json_string_tokens(text, key) if token[2] == wanted[0]]
        if len(tokens) != 1:
            continue
        start, end, _ = tokens[0]
        new_token = add(old_label.sub("", text[start:end]))
        changed = text[:start] + new_token + text[end:]
        try:
            json.loads(changed)
        except ValueError:
            return raw
        if changed.count(label) != 1:
            return raw
        return changed.encode("utf-8")
    return raw


# ---- The person file ("other") --------------------------------------------------------------------------------------

def read_person_file(path):
    """SL_USER, SL_FULLNAME and PASSWORD_HASH from a small KEY=value file. A plain password is never accepted."""
    if not path:
        raise CreatorError("--personal other needs --person-file: a small text file with the lines SL_USER=..., "
                           "SL_FULLNAME=... and PASSWORD_HASH=... for the person the drive is for")
    try:
        raw = Path(path).expanduser().read_bytes()
    except OSError as exc:
        raise CreatorError(f"the person file cannot be read: {exc.strerror or exc}") from exc
    if len(raw) > 65536:
        raise CreatorError("the person file is too big to be a person file")
    try:
        text = raw.decode("utf-8-sig")
    except UnicodeDecodeError as exc:
        raise CreatorError("the person file is not plain text (UTF-8)") from exc
    values = {}
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        key, separator, value = stripped.partition("=")
        key = key.strip()
        if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise CreatorError(f"line {number} of the person file is not a KEY=value line")
        if key not in PERSON_KEYS:
            if any(word in key.upper() for word in ("PASS", "PSK", "KEY", "SECRET")):
                raise CreatorError(f"the person file holds a password or key ({key}). A plain password is never put "
                                   "on a drive: give PASSWORD_HASH, a SHA-512 crypt hash ($6$...) made from their "
                                   "password, or use --personal none so they type it when they install")
            raise CreatorError(f"the person file has a setting this drive builder does not use: {key}. "
                               "Use only SL_USER, SL_FULLNAME and PASSWORD_HASH")
        if key in values:
            raise CreatorError(f"the person file gives {key} twice")
        values[key] = value.strip()
    missing = [key for key in PERSON_KEYS if not values.get(key)]
    if missing:
        raise CreatorError("the person file must give " + ", ".join(missing) + ". Nothing is ever made up. To let "
                           "the person type their own name and password when they install, use --personal none")
    if not PERSON_USER_RE.fullmatch(values["SL_USER"]):
        raise CreatorError("SL_USER in the person file must be a login name: small letters, digits, '-' and '_', "
                           "starting with a letter, 32 characters at most")
    if not PERSON_NAME_RE.fullmatch(values["SL_FULLNAME"]):
        raise CreatorError("SL_FULLNAME in the person file must be a plain name (no colons, quotes, backslashes or "
                           "dollar signs, 100 characters at most)")
    if not CRYPT_HASH_RE.fullmatch(values["PASSWORD_HASH"]):
        raise CreatorError("PASSWORD_HASH in the person file must be a SHA-512 crypt hash ($6$...). A plain "
                           "password is never put on a drive")
    return values


# ---- The drive's files for this copy ---------------------------------------------------------------------------------

def owner_secrets(found, payload_texts):
    """Long owner values that must never reach a drive for someone else (a last check after the files are made)."""
    secrets = []
    if found:
        secrets.append(("password hash", found.get("__PASSWORD_HASH__", "")))
        if found.get("__WIFI_PRE__", NO_WIFI_PRE) not in (NO_WIFI_PRE,) + MAKE_USB_NO_WIFI:
            secrets.append(("Wi-Fi setting", found["__WIFI_PRE__"]))
        if found.get("__WIFI_BLOCK__", NO_WIFI_BLOCK) not in (NO_WIFI_BLOCK,) + MAKE_USB_NO_WIFI:
            secrets.append(("Wi-Fi setting", found["__WIFI_BLOCK__"]))
        secrets.append(("Wi-Fi name", found.get("__HOME_WIFI_SSID_B64__", "")))
        for name, what in (("__WIFI_RECORDS__", "saved Wi-Fi"), ("__BACKUP_RECORDS__", "backup record")):
            for line in found.get(name, "").split("\n"):
                secrets.append((what, line))
                if name == "__WIFI_RECORDS__":
                    secrets.append((what, line.split("|")[-1]))
    for relative, text in payload_texts.items():
        if relative.lower().endswith("build.conf"):
            for key, value in build_conf_values(text).items():
                if key.startswith("HOME_SHARE_") or key == "IMMICH_URL":
                    secrets.append(("home-server setting", value))
        elif relative.lower().endswith(("wifi-networks.txt", "backups.txt")):
            for line in text.split("\n"):
                secrets.append(("saved Wi-Fi" if "wifi" in relative.lower() else "backup record", line.strip()))
                if "wifi" in relative.lower():
                    secrets.append(("saved Wi-Fi", line.strip().split("|")[-1]))
    return [(what, value) for what, value in secrets if len(value) >= 8]


def drive_blobs(relative, data):
    """The bytes of a new per-drive file, and of every file packed inside it."""
    yield relative, data
    lowered = relative.lower()
    try:
        if lowered == KS_PAYLOAD_PATH and data.count(KS_PAYLOAD_BEGIN) == 1:
            for member, body in packed_block_members(data):
                if body is not None:
                    yield relative + " (packed " + tar_key(member.name) + ")", body
        elif DEBIAN_ARCHIVE_RE.match(relative):
            for member, body in read_tar_members(data, relative):
                if body is not None:
                    yield relative + " (packed " + tar_key(member.name) + ")", body
    except CreatorError:
        return


def privacy_check(secrets, person, made):
    person_values = set((person or {}).values())
    wanted = [(what, value.encode("utf-8")) for what, value in secrets
              if value and value not in person_values and not any(value in mine for mine in person_values)]
    for relative, data in made.items():
        for where, blob in drive_blobs(relative, data):
            for what, value in wanted:
                if value in blob:
                    raise CreatorError(f"privacy check: the owner's {what} would still be on this drive ({where}), "
                                       "so nothing was written. " + NOT_FOR_SOMEONE_ELSE)


def drive_files_for(choice, root, manifest, files, person=None, never_online=False, keep_own=(), left_off=None,
                    saved_left_off=None):
    """(file entries for this drive, {path: new bytes or source path}) for every file that differs from the master.

    "mine" keeps every per-drive file exactly as saved. "none" and "other" get a new installer script and new
    build.conf and Debian files, and every other per-drive file of the owner is left out, as is every file the owner
    put on the stick by hand (owner_added_file) unless keep_own names it; those are added to left_off. One drive's
    saved changes (is_saved_changes_file, at any depth: persistence/, *persistence*.dat or .img) are always left out
    of "none" and "other", whatever keep_own says; those are added to saved_left_off (check R1 F-R1-3, C3 F2).
    """
    if choice not in PERSONAL_CHOICES:
        raise CreatorError(f"unknown choice {choice!r} for whose settings the drive carries; choose mine, none or other")
    matches = per_drive_matcher(tuple(per_drive_patterns()) + OWNER_COMPUTER_LISTS)
    kept_own = per_drive_matcher(tuple(keep_own)) if keep_own else (lambda path: False)
    by_path = {entry["path"]: entry for entry in files}
    release_id = manifest["release"]["release_id"]
    output, sources, made, payload_texts = [], {}, {}, {}
    found = None

    def replaced(entry, data):
        if data == payload_bytes(root, entry):
            return entry
        sources[entry["path"]] = data
        made[entry["path"]] = data
        return {"path": entry["path"], "size": len(data), "sha256": sha256_bytes(data)}

    for entry in files:
        relative = entry["path"]
        lowered = relative.lower()
        if lowered == VENTOY_CONFIG:
            output.append(replaced(entry, label_boot_menu(payload_bytes(root, entry), release_id)))
        elif lowered == KS_PAYLOAD_PATH:
            owner = payload_bytes(root, entry)
            if choice == "mine":
                new = rewrite_packed_build_conf(owner, choice, person, never_online) if never_online else owner
            else:
                try:
                    owner_text = owner.decode("utf-8")
                except UnicodeDecodeError as exc:
                    raise CreatorError("this saved master's installer script is not plain text. " + NOT_FOR_SOMEONE_ELSE) from exc
                text, found = installer_for_someone_else(choice, owner_text, installer_template_candidates(root, by_path),
                                                         person)
                packed = dict((tar_key(member.name), body) for member, body in packed_block_members(owner)
                              if body is not None)
                if "build.conf" in packed:
                    payload_texts[relative + " build.conf"] = packed["build.conf"].decode("utf-8", "replace")
                new = rewrite_packed_build_conf(text.encode("utf-8"), choice, person, never_online)
                made[relative] = new
            output.append(replaced(entry, new))
        elif lowered in BUILD_CONF_PATHS:
            owner = payload_bytes(root, entry)
            if choice != "mine":
                payload_texts[relative] = owner.decode("utf-8", "replace")
            new = build_conf_for(owner.decode("utf-8", "replace"), choice, person, never_online).encode("utf-8") \
                if (choice != "mine" or never_online) else owner
            if choice != "mine":
                made[relative] = new
            output.append(replaced(entry, new))
        elif DEBIAN_PRESEED_RE.match(relative) and choice != "mine":
            new = preseed_for(payload_bytes(root, entry).decode("utf-8", "replace"), choice, person).encode("utf-8")
            made[relative] = new
            output.append(replaced(entry, new))
        elif DEBIAN_ARCHIVE_RE.match(relative) and (choice != "mine" or never_online):
            new = debian_archive_for(payload_bytes(root, entry), choice, person, never_online, relative)
            made[relative] = new
            output.append(replaced(entry, new))
        elif choice != "mine" and is_saved_changes_file(relative):
            if saved_left_off is not None:
                saved_left_off.append(relative)
            continue                       # one person's saved changes: never on a drive for someone else
        elif choice != "mine" and matches(relative) and lowered != LAUNCHER_PATH.lower():
            if lowered.endswith((".txt", ".conf")) and lowered.startswith("linux-setup/"):
                try:
                    payload_texts[relative] = payload_bytes(root, entry).decode("utf-8")
                except UnicodeDecodeError:
                    pass
            continue                       # the owner's own file: never on a drive for someone else
        elif choice != "mine" and owner_added_file(relative) and not kept_own(relative):
            if left_off is not None:
                left_off.append(relative)
            continue                       # put on the stick by hand: stays on the owner's own drive
        else:
            output.append(entry)
    launcher = by_path.get(LAUNCHER_SOURCE)
    if launcher:
        output = [entry for entry in output if entry["path"].lower() != LAUNCHER_PATH.lower()]
        output.append({"path": LAUNCHER_PATH, "size": launcher["size"], "sha256": launcher["sha256"]})
        sources[LAUNCHER_PATH] = Path(root) / "payload" / LAUNCHER_SOURCE
    if choice != "mine":
        privacy_check(owner_secrets(found, payload_texts), person, made)
    return output, sources


def personal_summary(choice):
    if choice == "none":
        return ("This drive is for someone else: it carries none of your own settings (no account, Wi-Fi or "
                "home-server details). When they install, the setup screen asks for their name, login and password.")
    if choice == "other":
        return ("This drive is for someone else: it carries only the name, login and password hash from their person "
                "file, and none of your own settings.")
    return ("This drive is for you: it carries your own settings from the saved master "
            "(your account, Wi-Fi and home-server details). Do not give it to someone else.")


# ---- Helpers that run beside this tool: the drive test (C6) and the separate drive check (C) ------------------------

def helper_tool(name, mock_variable, mock):
    """A sibling Secure Linux tool. Test runs (--mock-devices) only ever use a stand-in named by an environment value."""
    if mock:
        value = os.environ.get(mock_variable)
        return Path(value) if value else None
    for directory in (Path(__file__).resolve().parent, Path("/usr/local/bin")):
        path = (directory / name)
        if path.is_file():
            return path.resolve()
    return None


def helper_command(path):
    try:
        with open(path, "rb") as handle:
            first = handle.readline(200)
    except OSError:
        first = b""
    if path.suffix == ".py" or (first.startswith(b"#!") and b"python" in first):
        return [sys.executable, str(path)]
    if first.startswith(b"#!") and b"sh" in first:
        return [shutil.which("bash") or "/bin/bash", str(path)]
    return [str(path)]


def run_drive_test(tool, target, depth):
    """C6: secure-linux-drive-test with the drive's own serial. It erases the drive, so it runs after ERASE was typed."""
    command = helper_command(tool) + ["--device", target["path"], "--confirm", "TEST " + identity_label(target)]
    if depth == "quick":
        command.append("--quick")
    say("Testing the drive first (its real size and its blocks). This erases it, as you confirmed.")
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL)
    except OSError as exc:
        raise CreatorError(f"the drive test could not start ({exc.strerror or exc}); nothing was copied") from exc
    if result.returncode == 0:
        say("Drive test passed.")
        return
    if result.returncode == 2:
        raise VerificationError("the drive test found a problem with this drive (see above). Do not use it: it may "
                                "be fake or failing. Nothing was copied.")
    raise CreatorError("the drive test could not test this drive (see above). Nothing was copied.")


def check_drive_after_copy(target, data_root, store, master_id, mock):
    """The drive repair tool's read-only check of the new drive, its verdict shown. 0 passed, 2 problem, None skipped."""
    tool = helper_tool(FIXER_TOOL, "SL_USBC_MOCK_FIXER", mock)
    if tool is None:
        say("Separate drive check: skipped, because the drive repair tool is not on this computer. "
            "The copy passed its own file-by-file check.")
        return None
    command = helper_command(tool) + ["check-drive", "--device", target["path"], "--drive-root", str(data_root),
                                      "--master-store", str(store), "--master-id", master_id, "--non-interactive"]
    say("Separate drive check: the drive repair tool now reads the new drive and compares it (it changes nothing).")
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL, timeout=6 * 3600)
    except (OSError, subprocess.TimeoutExpired) as exc:
        say(f"Separate drive check: it could not run ({type(exc).__name__}). The copy passed its own file-by-file check.")
        return None
    if result.returncode == 0:
        say("Separate drive check: PASSED. Every file on the drive is the one it should be.")
        return 0
    if result.returncode == 2:
        say("Separate drive check: it found a problem (shown above).")
        return 2
    say("Separate drive check: it could not check this drive (shown above). The copy passed its own file-by-file check.")
    return None


# ---- sync-master: what is new, and an older installer template -------------------------------------------------------

def release_notes_lines(tree, release_id):
    """The release's own notes (contract C2), as plain lines. Nothing when the release has none."""
    date = release_date(release_id)
    path = Path(tree) / "files" / "release-notes" / "release-notes.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return []
    if not date or not isinstance(data, dict) or data.get("schema_version") != 1:
        return []

    def clean(value):
        return "".join(character for character in str(value) if character.isprintable()).strip()

    for release in data.get("releases") or []:
        if isinstance(release, dict) and release.get("version") == date:
            title = clean(release.get("title") or "")
            lines = [f"What is new in release {date}" + (f": {title}" if title else ":")]
            for item in release.get("notes") or []:
                if isinstance(item, str) and clean(item):
                    lines.append("  - " + clean(item))
            return lines
    return []


def master_template_sha256(manifest):
    value = manifest.get("template_sha256")
    if isinstance(value, str) and HASH_RE.fullmatch(value):
        return value
    for entry in (manifest.get("portable") or {}).get("files") or []:
        if entry.get("path") == MASTER_TEMPLATE_PATH:
            return entry.get("sha256")
    return None


def kit_template_sha256(from_tree):
    """The installer template of the kit this computer runs, when it is reachable from here."""
    tree = Path(from_tree)
    candidates = [tree / "templates" / "fedora.ks", tree.parent / "templates" / "fedora.ks",
                  tree.parent / "kit" / "templates" / "fedora.ks"]
    if _REPOSITORY_ROOT is not None:
        candidates.append(_REPOSITORY_ROOT / "templates" / "fedora.ks")
    for path in candidates:
        if path.is_file() and not path.is_symlink():
            return hash_file(path)[1]
    return None


def warn_if_template_changed(manifest, from_tree):
    saved = master_template_sha256(manifest)
    current = kit_template_sha256(from_tree)
    if saved and current and saved != current:
        say(TEMPLATE_CHANGED_WARNING)
        return True
    return False


# ---- How a Portable tools copy uses the above (kept here so the lines above keep their numbers) ----------------------

PASSPORT_MADE_FOR = {
    "mine": "the person who made it (their own settings are on it)",
    "none": "someone else (no personal settings; the installer asks for their name, login and password)",
    "other": "someone else (only the values from their person file)",
}
COPY_MADE_FOR = {
    "mine": "Made for: you (your own settings are on it).",
    "none": "Made for: someone else (no personal settings; their installer asks for their name, login and password).",
    "other": "Made for: someone else (only the values from their person file).",
}


def drive_copy_plan(args, root, manifest, files):
    """(the drive's files, {path: new bytes or source path}, plan) for a Portable tools copy.

    The plan says whose settings the drive carries, whether its computers check online, and whether the drive is
    tested first. Every refusal here happens before anything is written.
    """
    plan = types.SimpleNamespace(
        personal=getattr(args, "personal", None) or "mine",
        never_online=bool(getattr(args, "never_check_online", False)),
        test_depth=getattr(args, "test_drive", None),
        test_tool=None,
        person=None,
        keep_own=tuple(getattr(args, "keep_own_file", None) or ()),
        left_off=[],
        saved_left_off=[],
    )
    person_file = getattr(args, "person_file", None)
    if plan.personal not in PERSONAL_CHOICES:
        raise CreatorError(f"unknown choice {plan.personal!r} for whose settings the drive carries; "
                           "choose mine, none or other")
    if person_file and plan.personal != "other":
        raise CreatorError("--person-file is used only with --personal other")
    if plan.keep_own and plan.personal == "mine":
        raise CreatorError("--keep-own-file is used only with --personal none or other (your own drive keeps every file)")
    for pattern in plan.keep_own:
        if not pattern or pattern.startswith("/") or "\\" in pattern or ".." in pattern.split("/"):
            raise CreatorError(f"--keep-own-file needs a path on the drive, for example \"Documents/**\" (not {pattern!r})")
    if plan.personal == "other":
        plan.person = read_person_file(person_file)
    if plan.test_depth:
        if getattr(args, "resume", False):
            raise CreatorError("a drive test erases the drive, so it cannot be combined with --resume; nothing was written")
        plan.test_tool = helper_tool(DRIVE_TEST_TOOL, "SL_USBC_MOCK_DRIVE_TEST", bool(getattr(args, "mock_devices", None)))
        if plan.test_tool is None:
            raise CreatorError("the drive test (secure-linux-drive-test) is not on this computer yet, so --test-drive "
                               "cannot be used; nothing was written")
    files, sources = drive_files_for(plan.personal, root, manifest, files, plan.person, plan.never_online,
                                     plan.keep_own, plan.left_off, plan.saved_left_off)
    return files, sources, plan


def copy_summary(plan, carries_personal):
    lines = []
    if plan.personal != "mine" or carries_personal:
        lines.append(personal_summary(plan.personal))
    if plan.never_online:
        lines.append("Computers set up from this drive never check online for Secure Linux updates "
                     "(KIT_UPDATE_ONLINE=no).")
    if plan.test_tool:
        lines.append("The drive is tested first, which also erases it; then Ventoy is installed.")
    left_off = sorted(getattr(plan, "left_off", None) or ())
    if left_off:
        shown = ", ".join(left_off[:SHOW_LEFT_OFF]) + (", ..." if len(left_off) > SHOW_LEFT_OFF else "")
        lines.append(f"Left off this drive: {len(left_off)} file(s) you put on your own drive yourself (they are not "
                     f"part of Secure Linux): {shown}. A drive for someone else never carries them. To take one along, "
                     "add --keep-own-file \"PATH\" (for a folder: \"FOLDER/**\").")
    saved = sorted(getattr(plan, "saved_left_off", None) or ())
    if saved:
        lines.append(f"Left off this drive: {len(saved)} saved-changes file(s) of your own drive ({', '.join(saved)}). "
                     "Saved changes hold one person's own files and settings, so a drive for someone else never "
                     "carries them.")
    return lines


def resume_mismatch(previous, variant):
    if previous.get("variant", variant) != variant:
        return "this interrupted copy used a different variant; rerun without --resume or with the same variant"
    return ("this interrupted copy was made with a different choice of whose settings it carries; "
            "rerun with --restart instead of --resume")


def open_after_drive_test(plan, devices, target, target_id, refreshed):
    """Test the drive first when asked (it is checked to be the same drive afterwards), then open it for Ventoy."""
    if plan.test_tool:
        run_drive_test(plan.test_tool, refreshed, plan.test_depth)
        tested = devices.find_path(target["path"])
        if identity(tested) != target_id or tested["size"] != target["size"]:
            raise CreatorError("target identity or capacity changed during the drive test; nothing was copied")
    return open_device(refreshed, True, devices.mock)


def open_source(source):
    """A file of the drive: new bytes made for this drive, or a saved file read from its place."""
    return io.BytesIO(source) if isinstance(source, bytes) else open(source, "rb")


def passport_and_drive_check(data_root, manifest, master_id, files, tree_hash, plan, target, store, devices):
    """Passport and drive file list (C3), then the separate read-only drive check. A problem it finds makes the copy
    NOT VERIFIED, and the passport then says so."""
    passport = write_drive_passport(data_root, manifest, master_id, files, "passed" if tree_hash else "failed",
                                    plan.personal)
    if check_drive_after_copy(target, data_root, store, master_id, devices.mock) == 2:
        write_drive_passport(data_root, manifest, master_id, files, "failed", plan.personal)
        raise VerificationError("the separate drive check found a problem with the new drive, so it is NOT VERIFIED. "
                                "Run the same copy again with --resume, or try another drive.")
    say(COPY_MADE_FOR[plan.personal])
    return passport


def template_record(manifest):
    """{"template_sha256": ...}: the installer template the saved drive was made from, when the master holds it."""
    value = master_template_sha256(manifest)
    return {"template_sha256": value} if value else {}


def sync_done(manifest, from_tree, tree=None, release_id=None):
    """After sync-master: the new release's notes (C2), and a plain warning when the kit's installer has moved on."""
    if tree is not None:
        for line in release_notes_lines(tree, release_id):
            say(line)
    warn_if_template_changed(manifest, from_tree)
    return 0


def ask_who_the_drive_is_for():
    """The text menu's question before a Portable tools copy: (choice, person file or None)."""
    say("Who is this drive for?")
    say("  1) You: it carries your own settings (your account, Wi-Fi and home-server details)")
    say("  2) Someone else: nothing of yours is on it; they type their own name, login and password when they install")
    say("  3) Someone else, from a person file (their login name, their name and a password hash)")
    while True:
        answer = input("Choose 1, 2 or 3: ").strip()
        if answer == "1":
            return "mine", None
        if answer == "2":
            return "none", None
        if answer == "3":
            return "other", input("Person file path: ").strip() or None
        say("Please choose 1, 2 or 3.")


def text_menu_copy_choices(args):
    args.personal, args.person_file = ask_who_the_drive_is_for()
    args.variant = "full"
    args.storage = "auto"
    args.storage_format = None
    args.app_bundle = "auto"
    args.never_check_online = False
    args.test_drive = None
    args.resume = False
    args.restart = False


# ---- Offline app collection from this computer (Matthew: apps go on the drive too) ------------------------------

def app_collection_for_copy(files, variant, choice, mock, with_hashes=True):
    """Extra file entries (and their source paths) for this computer's offline app collection.

    Used only for the full variant when the saved master holds no collection. `auto` reads this computer's own
    copy (never in --mock-devices tests); `none` leaves it out; a folder must hold current.json and its version.
    """
    if variant != "full" or choice == "none":
        return [], {}
    if any(entry["path"].startswith(ONLINE_ONLY_EXCLUDED_PREFIX) for entry in files):
        return [], {}        # the saved master holds the collection; it is copied from there
    explicit = choice not in (None, "", "auto")
    if explicit:
        directory = Path(choice).expanduser().resolve()
    elif mock:
        return [], {}
    else:
        directory = DEFAULT_APP_BUNDLE_DIR
    current_path = directory / "current.json"
    try:
        if not explicit and not current_path.exists():
            return [], {}
        if current_path.is_symlink() or not current_path.is_file():
            raise CreatorError("it has no current.json")
        try:
            current = json.loads(current_path.read_text(encoding="utf-8"))
        except (OSError, ValueError, UnicodeDecodeError) as exc:
            raise CreatorError("its current.json cannot be read") from exc
        version = current.get("bundle_version") if isinstance(current, dict) else None
        if not isinstance(version, str) or not ID_RE.fullmatch(version):
            raise CreatorError("its current.json names no valid version")
        version_root = directory / version
        if version_root.is_symlink() or not version_root.is_dir():
            raise CreatorError(f"its folder {version} is missing")
        sources = {ONLINE_ONLY_EXCLUDED_PREFIX + "current.json": current_path}
        for relative, path, _ in source_file_entries(version_root):
            sources[safe_payload_path(ONLINE_ONLY_EXCLUDED_PREFIX + version + "/" + relative)] = path
        bundle = []
        for drive_path, path in sources.items():
            if with_hashes:
                size, digest = hash_file(path)
            else:
                size, digest = path.stat().st_size, ""
            bundle.append({"path": drive_path, "size": size, "sha256": digest})
    except (CreatorError, OSError) as exc:
        if explicit:
            raise CreatorError(f"the offline app collection in {directory} cannot be used: {exc}") from exc
        note(f"Note: this computer's offline app collection cannot be used ({exc}), so the drive gets none.")
        return [], {}
    return bundle, sources


# ---- Drive-builder plug-ins (contract C17) ----------------------------------------------------------------------

def plugin_note(name, text):
    note(f"Note: the drive-builder add-on {name} {text}")


def plugin_directories():
    seen = []
    for directory in (_LIB, _FALLBACK_LIB):
        try:
            resolved = directory.resolve()
        except OSError:
            continue
        if directory.is_dir() and resolved not in seen:
            seen.append(resolved)
    return seen


def plugin_file_problem(path):
    """Run as administrator, an add-on must belong to the administrator and be changeable by nobody else."""
    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        return None
    info = path.stat()
    folder = path.parent.stat()
    if info.st_uid != 0 or folder.st_uid != 0:
        return "is not owned by the administrator"
    if info.st_mode & 0o022 or folder.st_mode & 0o022:
        return "can be changed by other users"
    return None


def load_plugins():
    """Load every usbc_<name>.py on the library path. A broken one costs one plain line and nothing else."""
    found = {}
    for directory in plugin_directories():
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for name in names:
            if PLUGIN_FILE_RE.fullmatch(name) and name not in found and (directory / name).is_file():
                found[name] = directory / name
    plugins = []
    for name, path in found.items():
        try:
            problem = plugin_file_problem(path)
            if problem:
                plugin_note(name, f"{problem}, so it was not loaded. Everything else works as normal.")
                continue
            sys.dont_write_bytecode = True
            spec = importlib.util.spec_from_file_location("secure_linux_" + name[:-3], str(path))
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            if not callable(getattr(module, "register", None)) or not callable(getattr(module, "run", None)):
                plugin_note(name, "has no register() and run(), so it was not loaded. Everything else works as normal.")
                continue
            plugins.append((name, module))
        except (Exception, SystemExit) as exc:
            plugin_note(name, f"could not be loaded ({type(exc).__name__}), so it was skipped. "
                              "Everything else works as normal.")
    return plugins


def register_plugins(subparsers, plugins):
    """Each add-on adds its own commands inside its own try. A core command can never be replaced."""
    commands = {}
    for name, module in plugins:
        before = dict(subparsers.choices)
        try:
            names = list(module.register(subparsers) or [])
            if not names or not all(isinstance(command, str) and command for command in names):
                raise ValueError("register() returned no command names")
            taken = [command for command in names if command in CORE_COMMANDS or command in commands]
            if taken or any(subparsers.choices.get(core) is not before.get(core) for core in before):
                raise ValueError("it tried to use a command name that is already taken: " + ", ".join(taken))
            missing = [command for command in names if command not in subparsers.choices]
            if missing:
                raise ValueError("register() named commands it did not add: " + ", ".join(missing))
        except (Exception, SystemExit) as exc:
            for added in [key for key in subparsers.choices if key not in before]:
                del subparsers.choices[added]
            for core, parser in before.items():
                subparsers.choices[core] = parser
            plugin_note(name, f"could not add its commands ({type(exc).__name__}: {exc}), so they are not available. "
                              "Everything else works as normal.")
            continue
        for command in names:
            commands[command] = module
    return commands


def free_space_ok(path, needed):
    probe = Path(path).expanduser().absolute()
    while not probe.exists() and probe.parent != probe:
        probe = probe.parent
    try:
        return shutil.disk_usage(probe).free >= int(needed)
    except OSError:
        return False


def verify_file(path, expected):
    try:
        path = Path(path)
        if path.is_symlink() or not path.is_file():
            return False
        return hash_file(path)[1] == str(expected).lower()
    except OSError:
        return False


def require_raw_access(args):
    if not getattr(args, "mock_devices", None) and hasattr(os, "geteuid") and os.geteuid() != 0:
        raise CreatorError("administrator rights are required for raw USB access; rerun with sudo, or use the app launcher")


def plugin_api():
    """The drive builder's own safe helpers, handed to every add-on (C17)."""
    return types.SimpleNamespace(
        load_master=load_master,
        store_lock=store_lock,
        free_space_ok=free_space_ok,
        verify_file=verify_file,
        say=say,
        CreatorError=CreatorError,
        VerificationError=VerificationError,
        StoreBusy=StoreBusy,
        require_raw_access=require_raw_access,
        app=APP,
        version=VERSION,
    )


def run_plugin_command(module, args):
    """An add-on command follows the core raw-access rule unless the add-on lists it in NO_DEVICE_COMMANDS."""
    if args.command not in tuple(getattr(module, "NO_DEVICE_COMMANDS", ()) or ()):
        require_raw_access(args)
    try:
        result = module.run(args, plugin_api())
    except (CreatorError, KeyboardInterrupt, EOFError, OSError):
        raise
    except Exception as exc:
        raise CreatorError(f"the add-on command {args.command} stopped: {type(exc).__name__}: {exc}") from exc
    return result if isinstance(result, int) else 0


def run_after_copy(target_root, manifest, args, state_path=None, final_state=None):
    """Called once after a verified portable copy. An add-on that fails here never undoes the verified copy."""
    for name, module in LOADED_PLUGINS:
        hook = getattr(module, "after_copy", None)
        if not callable(hook):
            continue
        try:
            hook(Path(target_root), manifest, args, plugin_api())
        except (Exception, SystemExit) as exc:
            plugin_note(name, f"stopped after the copy ({type(exc).__name__}). The drive itself is verified.")
    if state_path is not None and final_state is not None:
        refresh_copy_record_list(target_root, state_path, final_state)


def refresh_copy_record_list(target_root, state_path, final_state):
    """An add-on (live mode, linux/lib/usbc_live.py) may refresh the drive file list and passport after the copy
    record was saved (P28a finding F2). The record then names the list now on the drive, but only when the drive's
    passport and its file list agree; otherwise the record is left as it was and Check this drive reports the drive."""
    try:
        listing_hash = sha256_bytes((Path(target_root) / DRIVE_FILES_LIST).read_bytes())
        passport = json.loads((Path(target_root) / PASSPORT_JSON).read_bytes())
    except (OSError, ValueError):
        return
    if not isinstance(passport, dict) or passport.get("list_sha256") != listing_hash:
        return
    if final_state.get("drive_files_list_sha256") == listing_hash:
        return
    updated = dict(final_state)
    updated["drive_files_list_sha256"] = listing_hash
    try:
        save_state(state_path, updated)
    except OSError:
        pass   # the verified copy stands; the record keeps the list hash taken before the add-on ran


def add_mock(parser):
    parser.add_argument("--mock-devices", help="test-only JSON drive list; every listed path must be a regular file")


def add_current_release(parser):
    parser.add_argument(
        "--current-release",
        help="current kit's installed release.json (default: the copy beside this tool)",
    )


def add_store(parser):
    parser.add_argument("--store", required=True, help="master store containing current and immutable generations")
    parser.add_argument("--master-id", help="use a retained generation instead of current")
    parser.add_argument("--state-dir", help="clone receipts (default: STORE/clone-state)")
    add_current_release(parser)
    add_mock(parser)


APP_BUNDLE_HELP = (
    "offline app collection to put on the drive when the saved master has none: "
    "auto (this computer's own copy), none, or a folder holding current.json"
)


def build_parser(plugins=()):
    parser = argparse.ArgumentParser(prog="secure-linux-usb-creator", description=APP)
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command")
    listing = sub.add_parser("list", help="list removable whole drives, identity, capacity, free space and health")
    add_mock(listing)
    listing.add_argument("--json", action="store_true")
    create = sub.add_parser("create", help="create or update a verified compressed master generation")
    create.add_argument("--store", required=True)
    create.add_argument("--source", help="explicit finished source whole-drive path")
    create.add_argument(
        "--source-release",
        help="required release.json from the mounted finished USB (normally linux-setup/linux/release.json)",
    )
    create.add_argument(
        "--source-root",
        help="finished USB file-tree root (for example D:\\); captures every file for Portable tools copy",
    )
    create.add_argument("--chunk-size", type=parse_size, default=DEFAULT_CHUNK)
    create.add_argument(
        "--files-only", action="store_true",
        help="save the finished USB's files only (no whole-device image): needs room for the files, not the drive",
    )
    create.add_argument("--variant", choices=VARIANTS, default="full",
                        help="with --files-only: online-only leaves the offline app collection out of the saved master")
    create.add_argument("--non-interactive", action="store_true")
    add_current_release(create)
    add_mock(create)
    sync = sub.add_parser(
        "sync-master",
        help="bring the saved master up to the release this computer already runs, changing only what differs (works offline)",
    )
    sync.add_argument("--store", required=True)
    sync.add_argument("--master-id", help="update from a retained generation instead of current")
    sync.add_argument("--from-tree", required=True,
                      help="this computer's Secure Linux folder (normally /usr/local/lib/secure-linux)")
    clone = sub.add_parser("clone", help="exact whole-device clone with full verification and safe resume")
    add_store(clone)
    clone.add_argument("--target", help="explicit destination whole-drive path")
    clone.add_argument("--confirm", help="exact typed phrase: ERASE SERIAL-OR-WWN")
    mode = clone.add_mutually_exclusive_group()
    mode.add_argument("--resume", action="store_true", help="re-hash and retain a matching prefix")
    mode.add_argument("--restart", action="store_true", help="discard any partial target and restart at byte zero")
    clone.add_argument("--non-interactive", action="store_true")
    portable = sub.add_parser(
        "portable",
        help="Portable tools copy: install genuine Ventoy, copy and hash-verify every saved file (not an exact clone)",
    )
    add_store(portable)
    portable.add_argument("--target", help="explicit destination whole-drive path")
    portable.add_argument("--ventoy-installer", required=True, help="official Ventoy2Disk.sh from its genuine extracted package")
    portable.add_argument("--confirm", help="exact typed phrase: ERASE SERIAL-OR-WWN")
    portable_mode = portable.add_mutually_exclusive_group()
    portable_mode.add_argument("--resume", action="store_true", help="retain existing Ventoy and hash-matching copied files")
    portable_mode.add_argument("--restart", action="store_true", help="reinstall Ventoy and restart the complete file copy")
    portable.add_argument("--non-interactive", action="store_true")
    portable.add_argument(
        "--variant",
        choices=VARIANTS,
        default="full",
        help="full includes the offline app cache; online-only leaves it off (app installs then need internet)",
    )
    portable.add_argument(
        "--storage",
        choices=("auto", "remaining", "none"),
        default="auto",
        help="auto asks up front when the drive has 5+ GB spare (interactive only); remaining always creates a storage partition when possible; none never does",
    )
    portable.add_argument("--storage-format", help="filesystem for the storage partition (ntfs/exfat/fat32/ext4/btrfs/xfs/f2fs as available)")
    portable.add_argument("--app-bundle", default="auto", help=APP_BUNDLE_HELP)
    portable.add_argument(
        "--personal", choices=PERSONAL_CHOICES, default="mine",
        help="whose settings the drive carries: mine (yours, as saved), none (nobody's: the installer asks for the "
             "name, login and password) or other (only what --person-file gives)",
    )
    portable.add_argument(
        "--person-file",
        help="with --personal other: a text file with SL_USER=, SL_FULLNAME= and PASSWORD_HASH= ($6$ hash) lines; "
             "nothing else is used and nothing is made up",
    )
    portable.add_argument(
        "--keep-own-file", action="append", metavar="PATH",
        help="with --personal none or other: also copy this file (or FOLDER/**) that you put on your own drive "
             "yourself; without it such files stay off a drive for someone else",
    )
    portable.add_argument(
        "--never-check-online", action="store_true",
        help="computers set up from this drive never check online for Secure Linux updates (KIT_UPDATE_ONLINE=no)",
    )
    portable.add_argument(
        "--test-drive", nargs="?", const="full", choices=("full", "quick"),
        help="test the drive first with secure-linux-drive-test (this erases it): full (default) or quick",
    )
    measure = sub.add_parser("measure", help="report source used bytes and exact/portable minimum destination sizes")
    measure.add_argument("--variant", choices=VARIANTS, default="full", help="variant to report as the primary minimum")
    add_store(measure)
    measure.add_argument("--target", help="optional target for a read-only fit check")
    measure.add_argument("--json", action="store_true")
    measure.add_argument("--app-bundle", default="auto", help=APP_BUNDLE_HELP)
    verify = sub.add_parser("verify", help="read-only full-content verification of an exact-clone target")
    add_store(verify)
    verify.add_argument("--target", required=True)
    verify.add_argument("--json", action="store_true")
    status_parser = sub.add_parser("status", help="show the durable verified/incomplete receipt")
    add_store(status_parser)
    status_parser.add_argument("--target", required=True)
    status_parser.add_argument("--json", action="store_true")
    parser.plugin_commands = register_plugins(sub, plugins)
    return parser


def run_store_command(args):
    """The core commands that use the saved master; the caller already holds the store lock."""
    if args.command == "create":
        return create_master(args)
    if args.command == "sync-master":
        return sync_master(args)
    if args.command == "clone":
        try:
            return clone_master(args)
        except KeyboardInterrupt:
            raise
        except Exception:
            retry_guidance()
            raise
    if args.command == "portable":
        try:
            return portable_copy(args)
        except KeyboardInterrupt:
            raise
        except Exception:
            portable_retry_guidance()
            raise
    if args.command == "measure":
        return measure_command(args)
    if args.command == "verify":
        return verify_target(args)
    return target_status(args)


# ---- one drive's saved changes never go into a saved master (P28a finding F1, privacy) ----------------------------
# The same files linux/lib/usbc_live.py (PERSISTENCE_GLOBS) leaves out of a master: the live drive's own
# persistence/ folder and any Ventoy saved-changes file (*persistence*.dat or .img) anywhere on the drive.
SAVED_CHANGES_GLOBS = (re.compile(r"^persistence/", re.I), re.compile(r"(^|/)[^/]*persistence[^/]*\.(dat|img)$", re.I))


def is_saved_changes_file(relative):
    return any(regex.search(relative) for regex in SAVED_CHANGES_GLOBS)


def master_skips(relative, skip_prefixes, left_out=None, folder=None):
    """True for a file (or a folder, ending in /) a files-only master never keeps. Saved-changes files left out are
    added to left_out (when given), so the person is told; a skipped folder is listed file by file."""
    saved = is_saved_changes_file(relative)
    if not (saved or relative.startswith(tuple(skip_prefixes))):
        return False
    if saved and left_out is not None:
        if folder is None:
            left_out.append(relative)
        else:
            for base, _, names in os.walk(folder, followlinks=False):
                left_out.extend(relative + (Path(base) / name).relative_to(folder).as_posix() for name in sorted(names))
    return True


def say_saved_changes_left_out(left_out):
    if left_out:
        say(f"Left out: {len(left_out)} saved-changes file(s) of one drive ({', '.join(sorted(left_out))}). "
            "One person's saved changes never go into a saved master.")


def files_only_entries(source_root):
    """Every file a files-only master keeps (FILES_ONLY_SKIP_PREFIXES and saved changes left out), said once."""
    left_out = []
    entries = source_file_entries(source_root, FILES_ONLY_SKIP_PREFIXES, left_out)
    say_saved_changes_left_out(left_out)
    return entries


def sync_kept_entries(files):
    """sync-master's starting list: every saved file except saved changes an older master may still hold."""
    left_out = [entry["path"] for entry in files if is_saved_changes_file(entry["path"])]
    say_saved_changes_left_out(left_out)
    return {entry["path"]: entry for entry in files if entry["path"] not in left_out}


def main(argv=None):
    global LOADED_PLUGINS
    LOADED_PLUGINS = load_plugins()
    parser = build_parser(LOADED_PLUGINS)
    args = parser.parse_args(argv)
    try:
        if args.command is None:
            return interactive(args)
        if args.command in parser.plugin_commands:
            return run_plugin_command(parser.plugin_commands[args.command], args)
        if args.command == "list":
            rows = Devices(args.mock_devices).scan()
            if args.json:
                say(json.dumps({"devices": rows}, indent=2, sort_keys=True))
            else:
                show_devices(rows)
            return 0
        files_only_create = args.command == "create" and getattr(args, "files_only", False)   # reads files, never a raw drive
        if (args.command in ("create", "clone", "portable", "verify") and not files_only_create and not args.mock_devices
                and hasattr(os, "geteuid") and os.geteuid() != 0):
            raise CreatorError("administrator rights are required for raw USB access; rerun with sudo, or use the app launcher")
        if args.command not in STORE_LOCK_MODES:
            parser.error("unknown command")
        with store_lock(store_for_lock(args), STORE_LOCK_MODES[args.command]):
            return run_store_command(args)
    except StoreBusy as exc:
        say(f"STOPPED SAFELY: {exc}")
        return STORE_BUSY_EXIT
    except VerificationError as exc:
        say(f"VERIFICATION FAILED: {exc}")
        return 2
    except CreatorError as exc:
        say(f"REFUSED / STOPPED SAFELY: {exc}")
        return 1
    except EOFError:
        say("Input ended. Cancelled safely; no new write was started.")
        return 1
    except KeyboardInterrupt:
        say("Interrupted. Any target remains INCOMPLETE / NOT VERIFIED; rerun the same copy command to resume safely.")
        return 130
    except OSError as exc:
        say(f"STOPPED SAFELY: operating-system error: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
