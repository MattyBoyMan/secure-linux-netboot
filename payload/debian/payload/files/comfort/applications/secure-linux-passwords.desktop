[Desktop Entry]
Type=Application
Version=1.0
Name=Move My Passwords from Chrome or Edge
GenericName=Guided password migration
Comment=Export old browser passwords, import them into your password manager and remove the export after checking
Exec=/usr/local/bin/secure-linux-migrate page passwords
Icon=dialog-password
Terminal=false
Categories=Utility;Security;
Keywords=passwords;Chrome;Edge;Google;Bitwarden;KeePassXC;import;migration;
StartupNotify=true
