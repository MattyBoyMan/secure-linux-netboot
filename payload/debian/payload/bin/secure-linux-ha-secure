#!/bin/bash
# secure-linux-ha-secure: how safe is your Home Assistant? A grade from A to F, in plain English.
#
#   secure-linux-ha-secure --guided                       friendly walk-through (start here)
#   secure-linux-ha-secure --check [WHERE]                score it. Read-only: nothing is changed.
#   secure-linux-ha-secure --apply --config FOLDER [--yes]
#                                                         fix the safe things automatically: shows you each change
#                                                         first, asks for "yes", saves a restore point, undoes itself if
#                                                         the result would not load
#   secure-linux-ha-secure --report [FILE] [WHERE]        write the results to a file you can keep (no secrets inside)
#   secure-linux-ha-secure --checklist                    answer the questions only you can answer (router, backups...)
#   secure-linux-ha-secure --list | --explain ID          every check / why one matters
#   secure-linux-ha-secure attest KEY VALUE               record one answer
#
# WHERE (pick one; if you don't, I use what you've set up):
#   --config /path/to/config     a Home Assistant config folder on this computer (a copy or a mounted folder)
#   --ssh user@server            look over SSH. Only yes/no facts come back; passwords and tokens never leave the server
#   --api                        ask Home Assistant itself using a token from a private file (secure-linux-ha token-set)
#   (extra: --ha-dir PATH for --ssh when the config folder isn't found by itself; --json for computer-readable output)
set -u   # no pipefail: "cmd | grep -q" must not fail when grep stops reading early
SL_ROOT=${SL_ROOT:-/usr/local/lib/secure-linux}
. "$SL_ROOT/lib/common.sh"
. "$SL_ROOT/files/homeassistant/ha-lib.sh"

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }
say() { ha_say "$@"; }
ask() { local a; printf '%s ' "$1" >&2; IFS= read -r a || a=""; printf '%s' "$a"; }

ORIG=("$@")
action="" cfg="" sshto="" api=no json=no yes=no out="" key="" val="" hadir="" url=""
tokfile=$(sl_choice_get ha_token_file "$HA_TOKEN_FILE_DEFAULT")
attest=$HA_ATTEST
while [ $# -gt 0 ]; do
  case $1 in
    --guided) action=guided ;; --check) action=check ;; --apply) action=apply ;; --report) action=report; if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then out=$2; shift; fi ;;
    --checklist) action=checklist ;; --list) action=list ;; --explain) action=explain; key=${2:-}; shift ;;
    attest) action=attest; key=${2:-}; val=${3:-}; shift 2 2>/dev/null ;;
    --config) cfg=${2:-}; shift ;; --ssh) sshto=${2:-}; shift ;; --api) api=yes ;; --json) json=yes ;; --yes) yes=yes ;;
    --ha-dir) hadir=${2:-}; shift ;; --url) url=${2:-}; shift ;; --token-file) tokfile=${2:-}; shift ;; --attest) attest=${2:-}; shift ;;
    -h|--help|help) usage; exit 0 ;;
    *) say "I don't understand '$1'."; usage; exit 2 ;;
  esac
  shift
done
[ -n "$action" ] || { usage; exit 2; }
[ -n "$url" ] || url=$(ha_url)
export SL_HA_REMOTE_MODE; SL_HA_REMOTE_MODE=$(sl_choice_get ha_remote_mode "")
( umask 077; mkdir -p "$(dirname "$attest")" ) 2>/dev/null

ENG=(python3 "$HA_ENGINE")
now_args=(); [ -n "${HA_TEST_NOW:-}" ] && now_args=(--now "$HA_TEST_NOW")

# what to look at when the user didn't say
pick_source() {
  [ -n "$cfg$sshto" ] || [ $api = yes ] && return 0
  local s; s=$(sl_choice_get ha_ssh "")
  if [ -n "$s" ]; then sshto=$s
  elif [ -e "$tokfile" ]; then api=yes
  elif [ -f "$(ha_config_dir)/configuration.yaml" ]; then cfg=$(ha_config_dir)
  else
    say "I don't know where to look yet. Tell me one of:"
    say "  --config /path/to/config   (a copy of your Home Assistant config folder)"
    say "  --ssh you@10.0.30.42       (your home server)"
    say "  --api                      (needs: secure-linux-ha token-set)"
    return 1
  fi
}
src_args=()
build_src() {
  src_args=()
  [ -n "$cfg" ] && src_args+=(--config "$cfg")
  [ -n "$sshto" ] && { ha_valid_target "$sshto" || { say "'$sshto' isn't a valid server address (use name@address)."; return 1; }; src_args+=(--ssh "$sshto"); }
  [ $api = yes ] && src_args+=(--api --url "$url" --token-file "$tokfile")
  [ -n "$hadir" ] && src_args+=(--ha-dir "$hadir")
  return 0
}
need_root_for_token() { [ $api = yes ] && [ -e "$tokfile" ] && [ ! -r "$tokfile" ] && [ "$(id -u)" -ne 0 ]; }
latest_version() {
  [ -n "${SL_HA_NO_NET:-}" ] && return 0
  curl -fsS --max-time 8 https://version.home-assistant.io/stable.json 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["homeassistant"]["default"])' 2>/dev/null
}

run_check() {   # run_check [extra engine args]  -> prints, sets $LASTOUT file
  local latest la=() rc; latest=$(latest_version); [ -n "$latest" ] && la=(--latest "$latest")
  LASTOUT=$(mktemp); trap 'rm -f "$LASTOUT"' EXIT
  "${ENG[@]}" check "${src_args[@]}" --attest "$attest" "${now_args[@]}" "${la[@]}" "$@" > "$LASTOUT"; rc=$?
  cat "$LASTOUT"
  if [ $json = no ] && grep -q '^Grade:' "$LASTOUT"; then
    ( umask 077; mkdir -p "$HA_USTATE"; printf '%s on %s\n' "$(sed -n 's/^\(Grade: .*\)$/\1/p' "$LASTOUT" | head -1 | sed 's/ *(checked.*//' | tr -s ' ')" "$(date +%F)" > "$HA_USTATE/ha-last-check.new" ) \
      && mv -f "$HA_USTATE/ha-last-check.new" "$HA_USTATE/ha-last-check" 2>/dev/null
    [ -n "${PKEXEC_UID:-}" ] && chown "$PKEXEC_UID" "$HA_USTATE/ha-last-check" 2>/dev/null
  fi
  return $rc
}

do_checklist() {
  local line k q choices h cur new ok n=0 total
  total=$("${ENG[@]}" questions | wc -l)
  say "A few questions only you can answer (about your router, backups and habits)."
  say "Press Enter to keep the current answer. There are $total; you can stop any time with Ctrl+C and carry on later."
  say ""
  while IFS=$'\t' read -r k q choices h <&3; do
    n=$((n+1))
    cur=$(sed -n "s/^$k=//p" "$attest" 2>/dev/null | tail -1)
    say "[$n/$total] $q"
    say "   ($h)"
    say "   Choices: $choices    Current: ${cur:-not answered}"
    while :; do
      new=$(ask "   Your answer:")
      [ -z "$new" ] && break
      ok=no
      case $choices in
        DATE\|no) [[ $new =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || [ "$new" = no ] && ok=yes ;;
        NUMBER\|na) [[ $new =~ ^[0-9]{1,3}$ ]] || [ "$new" = na ] && ok=yes ;;
        *) case "|$choices|" in *"|$new|"*) ok=yes ;; esac ;;
      esac
      if [ $ok = yes ]; then "${ENG[@]}" attest "$k" "$new" --attest "$attest" >/dev/null; [ "$k" = remote_mode ] && ha_remember_remote "$new"; break; fi
      say "   Please type one of: $choices"
    done
  done 3< <("${ENG[@]}" questions)   # the questions come on fd 3 so your answers can be read from the keyboard
  say ""; say "Saved in $attest. Now run: secure-linux-ha-secure --check"
}
ha_remember_remote() { "$SL_ROOT/bin/secure-linux-choice" set ha_remote_mode "$1" >/dev/null 2>&1; return 0; }

do_guided() {
  # Beginner contract: at most three inputs and three screens. The complete
  # 20-question checklist remains available explicitly as --checklist.
  say "Home Assistant security check — 3 short screens at most"
  say "======================================================"
  say "It only LOOKS. Passwords and tokens are never shown or saved in the report."
  say "Saved server, token and local-config choices are discovered automatically."
  say ""
  say "Screen 1 of 3: find Home Assistant"
  if [ -z "$cfg$sshto" ] && [ $api = no ]; then
    if pick_source; then
      say "Using your saved or safely detected source; no address question is needed."
    else
      say "No saved source was found. Choose once (advanced flags can skip this screen):"
      say "  1) Over SSH at my home server   (most complete)"
      say "  2) At a copy of the config folder on this computer"
      say "  3) Ask Home Assistant itself with an access token"
      local c; c=$(ask "Type 1, 2 or 3 (Enter to cancel):")
      case $c in
        1) sshto=$(ask "Server address like matt@10.0.30.42:"); ha_valid_target "$sshto" || { say "That doesn't look like name@address."; return 1; } ;;
        2) cfg=$(ask "Folder (the one that holds configuration.yaml):"); cfg=${cfg:-$(ha_config_dir)} ;;
        3) api=yes; [ -e "$tokfile" ] || { say "You need a token first: secure-linux-ha token-set"; return 1; } ;;
        *) say "Okay, nothing done."; return 0 ;;
      esac
    fi
  fi
  build_src || return 1
  if need_root_for_token; then say "Your token is kept in a private file; I'll ask for your password to read it."; fi
  say ""; say "Screen 2 of 3: read the results"
  run_check || return $?
  if [ -n "$cfg" ]; then
    say ""; say "Screen 3 of 3: optional safe fixes"
    local a; a=$(ask "Fix the safe things automatically? You'll see each change first. (yes/no)")
    [ "$a" = yes ] && "${ENG[@]}" apply --config "$cfg" --attest "$attest" "${now_args[@]}"
  fi
  say ""; say "Advanced details: secure-linux-ha-secure --checklist answers the 20 router, backup and habit questions separately."
  say "The default guide does not launch that checklist or repeat its questions. Run this check again after fixing things."
}

pick_source_needed() { case $action in check|apply|report|guided) return 0 ;; *) return 1 ;; esac; }
if pick_source_needed && [ $action != guided ]; then pick_source || exit 2; fi
build_src || exit 2
if need_root_for_token && [ $action != guided ]; then
  exec pkexec "$(readlink -f "$0")" "${ORIG[@]}" --attest "$attest" --url "$url" --token-file "$tokfile"
fi

case $action in
  guided) do_guided ;;
  check) run_check $([ $json = yes ] && echo --json) ;;
  apply)
    [ -n "$cfg" ] || { say "Automatic fixes work on a config folder: add --config /path/to/config. (For the server or the API I show the steps in the check; nothing is changed remotely.)"; exit 2; }
    "${ENG[@]}" apply --config "$cfg" --attest "$attest" "${now_args[@]}" $([ $yes = yes ] && echo --yes) ;;
  report)
    out=${out:-${HOME:-/root}/ha-security-report-$(date +%F).md}
    "${ENG[@]}" report "${src_args[@]}" --attest "$attest" "${now_args[@]}" --out "$out" ;;
  checklist) do_checklist ;;
  list) "${ENG[@]}" list-checks | awk -F'|' '{printf "%-24s %-18s %s%s\n", $1, $2, $5, ($4=="critical" ? "  [serious]" : "")}' ;;
  explain) "${ENG[@]}" explain "$key" ;;
  attest) "${ENG[@]}" attest "$key" "$val" --attest "$attest" ;;
esac
