PERSON_NAME_RE = re.compile(r"^[^\x00-\x1f\x7f:\"\\$`]{1,100}$")
CRYPT_HASH_RE = re.compile(r"^\$6\$(?:rounds=[0-9]{1,9}\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}$")
RELEASE_DATE_RE = re.compile(r"^secure-linux-([0-9]{4}\.[0-9]{2}\.[0-9]{2})-[0-9a-f]+$")
