# secrets.yaml.example  -  how to keep passwords and keys OUT of your other files
# Copy to secrets.yaml (same folder as configuration.yaml), fill in real values, and lock it:  chmod 600 secrets.yaml
# NEVER put secrets.yaml in Git, in a screenshot, or in a forum post. (secure-linux-ha snapshot keeps it out of Git.)
# Use a secret in any other file like this:
#     password: !secret camera_password
# Names are lowercase with underscores. Values are in quotes if they contain : # or spaces.

camera_password: "change-me-to-a-long-random-password"
mqtt_password: "change-me-too"
home_latitude: -37.8136
home_longitude: 144.9631
