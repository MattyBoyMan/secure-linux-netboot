#!/bin/bash
# secure-linux-parts: finds what hardware this computer has and makes sure the software to USE it is installed
# (disc burning for a DVD drive, scanner and printer drivers, Bluetooth, fingerprint, drawing tablet, game controllers...).
#
#   secure-linux-parts --check       show every device found and what is installed / missing (changes nothing; default)
#   secure-linux-parts --install     install what is missing (needs administrator rights and the internet)
#   secure-linux-parts --reassert    repair mode: put back only software that this tool installed earlier and that went missing
#   secure-linux-parts --hotplug     (used by the udev rule) a NEW device was plugged in: tell the user and install its software
#   secure-linux-parts --json        with --check: machine-readable result
#   secure-linux-parts --no-drivers  with --install: do not run secure-linux-drivers (graphics / Wi-Fi / Mac drivers)
#   secure-linux-parts --quiet       less output
#
# Only packages from Fedora's own repositories (and RPM Fusion, which Secure Linux already uses) are ever installed.
# Nothing is downloaded from anywhere else. Safe to run again (idempotent). Full / lite / atomic aware: on the atomic
# edition nothing is layered automatically; it prints the rpm-ostree command instead. Not Fedora (for example
# SystemRescue)? It only lists what you would need.
set -u
export LC_ALL=C
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0"); HERE=$(dirname "$SELF")
SL_ROOT=${SL_ROOT:-/usr/local/lib/secure-linux}
HLIB=""
for c in "$SL_ROOT/hw/health" "$HERE/../hw/health"; do [ -r "$c/lib.sh" ] && { HLIB=$c; break; }; done
[ -n "$HLIB" ] || { echo "secure-linux-parts: cannot find hw/health/lib.sh" >&2; exit 3; }
[ -d "$SL_ROOT/hw" ] || SL_ROOT=$(cd "$HLIB/../.." && pwd)
SLH_TITLE="Software for your hardware"
# A hardware-test fixture (as in tests/hardware) replaces /sys and /proc
if [ -n "${SL_HW_FIXTURE:-}" ]; then SL_TEST_SYSFS=${SL_TEST_SYSFS:-$SL_HW_FIXTURE/sys}; SL_TEST_PROC=${SL_TEST_PROC:-$SL_HW_FIXTURE/proc}; export SL_TEST_SYSFS SL_TEST_PROC; fi
# shellcheck source=../hw/health/lib.sh
. "$HLIB/lib.sh"
. "$HLIB/checks-io.sh"      # for slh_inputs
SL_STATE=${SL_STATE:-/var/lib/secure-linux}
MAP=""
for c in "${SL_PARTS_MAP:-}" "$SL_ROOT/files/hardware/parts.map" "$HERE/../files/hardware/parts.map"; do [ -n "$c" ] && [ -r "$c" ] && { MAP=$c; break; }; done
[ -n "$MAP" ] || { echo "secure-linux-parts: cannot find parts.map" >&2; exit 3; }
usage() { sed -n '2,/^# SystemRescue/p' "$SELF" | sed 's/^# \{0,1\}//'; }

ORIG_ARGS=("$@")
ACTION=check; JSON=0; QUIET=0; DRIVERS=1
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --check|check) ACTION=check ;; --install|install) ACTION=install ;; --reassert) ACTION=reassert ;; --hotplug) ACTION=hotplug ;;
    --json) JSON=1 ;; --quiet|-q) QUIET=1 ;; --no-drivers) DRIVERS=0 ;;
    *) echo "Unknown option: $1  (try --help)" >&2; exit 3 ;;
  esac
  shift
done
say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }

# ---------------------------------------------------------------- environment: profile, OS, package manager
PROFILE=${SL_PROFILE:-}
[ -n "$PROFILE" ] || PROFILE=$(cat "$SL_ETC/profile" 2>/dev/null)
if [ -z "$PROFILE" ]; then
  mem=$(awk '/^MemTotal:/{print int($2/1048576)}' "$SLH_PROC/meminfo" 2>/dev/null); PROFILE=full; [ "${mem:-8}" -lt 4 ] && PROFILE=lite
fi
[ -e /run/ostree-booted ] && PROFILE=atomic
OSID=$(. "${SL_TEST_OSRELEASE:-/etc/os-release}" 2>/dev/null; echo "${ID:-unknown} ${ID_LIKE:-}")
case " $OSID " in *" fedora "*|*" rhel "*) IS_FEDORA=1 ;; *) IS_FEDORA=0 ;; esac
CAN_INSTALL=1; WHY_NOT=""
if [ "$IS_FEDORA" = 0 ]; then CAN_INSTALL=0; WHY_NOT="This is not Fedora (for example a rescue system), so nothing is installed here. The list shows what the installed Secure Linux computer would add."
elif [ "$PROFILE" = atomic ]; then CAN_INSTALL=0; WHY_NOT="This is the image-based (atomic) edition: it does not install packages by itself. The commands to layer them are shown instead."
elif ! have dnf && ! have rpm; then CAN_INSTALL=0; WHY_NOT="No package manager (dnf) was found, so nothing can be installed here."; fi
pkg_installed() { rpm -q "$1" >/dev/null 2>&1 || rpm -q --whatprovides "$1" >/dev/null 2>&1; }
have rpm || pkg_installed() { return 1; }

# ---------------------------------------------------------------- discovery (read once)
PCI_LIST=$(slh_pci_list); USB_LIST=$(slh_usb_list); USBIF_LIST=$(slh_usb_ifaces); INPUT_LIST=$(slh_inputs)
MATCH_LABEL=""
usb_label() {   # usb_label BUSID_OR_IFACE -> product name (no forks)
  local b=${1%%:*} id vid pid prod rest
  while IFS='|' read -r id vid pid prod rest; do
    [ "$id" = "$b" ] && { printf '%s' "${prod:-$vid:$pid}"; return; }
  done <<< "$USB_LIST"
  printf 'USB device'
}
words_match() {   # words_match "w1,w2" "text" -> 0 if the (lower case) text contains any word; no forks
  local -a ws; local w
  IFS=',' read -ra ws <<< "$1"
  for w in "${ws[@]}"; do [ -n "$w" ] && case "$2" in *"$w"*) return 0 ;; esac; done
  return 1
}
atom() {   # atom ATOM -> 0 if it matches; sets MATCH_LABEL
  local kind=${1%%:*} arg=${1#*:} g s v d c drv lc
  case "$kind" in
    always) MATCH_LABEL="this computer"; return 0 ;;
    sys) for g in "$SLH_SYS"/$arg; do [ -e "$g" ] && { MATCH_LABEL=${g##*/}; return 0; }; done; return 1 ;;
    dev) for g in "$SLH_DEV"/$arg; do [ -e "$g" ] && { MATCH_LABEL=${g##*/}; return 0; }; done; return 1 ;;
    pci)
      local cls vid="" did="" rest
      cls=${arg%%/*}; rest=""; case "$arg" in */*) rest=${arg#*/} ;; esac
      vid=${rest%%/*}; case "$rest" in */*) did=${rest#*/} ;; esac
      while IFS='|' read -r s v d c drv; do
        [ -n "$s" ] || continue
        case "$c" in "$cls"*) ;; *) continue ;; esac
        [ -z "$vid" ] || [ "$v" = "$vid" ] || continue
        [ -z "$did" ] || [ "$d" = "$did" ] || continue
        MATCH_LABEL=$(slh_pci_name "$s" "$v" "$d"); return 0
      done <<< "$PCI_LIST"; return 1 ;;
    usbif) local id cl sub dr
      while IFS='|' read -r id cl sub dr; do [ "$cl" = "$arg" ] && { MATCH_LABEL=$(usb_label "$id"); return 0; }; done <<< "$USBIF_LIST"; return 1 ;;
    usbdev) local id vid pid prod man cl spd ver
      while IFS='|' read -r id vid pid prod man cl spd ver; do [ -n "$id" ] && [ "$cl" = "$arg" ] && { MATCH_LABEL=${prod:-$vid:$pid}; return 0; }; done <<< "$USB_LIST"; return 1 ;;
    usbid) local id vid pid prod man cl spd ver av=${arg%%:*} ap=""; case "$arg" in *:*) ap=${arg#*:} ;; esac
      while IFS='|' read -r id vid pid prod man cl spd ver; do [ -n "$id" ] || continue
        [ "$vid" = "$av" ] && { [ -z "$ap" ] || [ "$pid" = "$ap" ]; } && { MATCH_LABEL=${prod:-$vid:$pid}; return 0; }; done <<< "$USB_LIST"; return 1 ;;
    usbname) local id vid pid prod man cl spd ver
      while IFS='|' read -r id vid pid prod man cl spd ver; do [ -n "$id" ] || continue
        lc="$prod $man"; lc=${lc,,}
        words_match "$arg" "$lc" && { MATCH_LABEL=${prod:-$vid:$pid}; return 0; }
      done <<< "$USB_LIST"; return 1 ;;
    input) local nm h rest
      while IFS='|' read -r nm h rest; do [ -n "$nm" ] || continue
        lc=${nm,,}
        words_match "$arg" "$lc" && { MATCH_LABEL=$nm; return 0; }
      done <<< "$INPUT_LIST"; return 1 ;;
    dmi) local fld=${arg%%=*} words=${arg#*=} val
      slh_rdv val "$SLH_SYS/class/dmi/id/$fld"; val=${val,,}
      if words_match "$words" "$val"; then slh_rdv MATCH_LABEL "$SLH_SYS/class/dmi/id/product_name"; return 0; fi
      return 1 ;;
  esac
  return 1
}
rule_match() {   # rule_match RULE -> 0 if matches
  local rule=$1 term a ok label=""
  local -a terms atoms
  IFS=';' read -ra terms <<< "$rule"
  for term in "${terms[@]}"; do
    ok=1; label=""
    IFS='+' read -ra atoms <<< "$term"
    for a in "${atoms[@]}"; do
      [ -n "$a" ] || continue
      if atom "$a"; then [ -n "$label" ] || label=$MATCH_LABEL; else ok=0; break; fi
    done
    if [ "$ok" = 1 ]; then MATCH_LABEL=$label; return 0; fi
  done
  return 1
}

# ---------------------------------------------------------------- the scan
declare -a M_ID=() M_TITLE=() M_LABEL=() M_PKGS=() M_MISSING=() M_UNITS=() M_STATE=() M_WHY=() M_DRIVERS=()
scan() {
  local line id rule core full lite units title why pk missing p n=0 extra
  M_ID=(); M_TITLE=(); M_LABEL=(); M_PKGS=(); M_MISSING=(); M_UNITS=(); M_STATE=(); M_WHY=(); M_DRIVERS=()
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    IFS='|' read -r id rule core full lite units title why <<< "$line"
    rule_match "$rule" || continue
    pk=""; extra=""
    case "$PROFILE" in full) extra=$full ;; lite) extra=$lite ;; *) extra="" ;; esac
    [ "$core" = - ] && core=""; [ "$extra" = - ] && extra=""; [ "$units" = - ] && units=""
    local drv=0
    if [ "$core" = "@drivers" ]; then drv=1; core=""; fi
    pk=$(printf '%s %s' "$core" "$extra" | tr -s ' ' '\n' | sed '/^$/d' | awk '!s[$0]++' | tr '\n' ' '); pk=${pk% }
    missing=""
    for p in $pk; do pkg_installed "$p" || missing="$missing $p"; done; missing=${missing# }
    M_ID[n]=$id; M_TITLE[n]=$title; M_LABEL[n]=$MATCH_LABEL; M_PKGS[n]=$pk; M_MISSING[n]=$missing; M_UNITS[n]=$units; M_WHY[n]=$why; M_DRIVERS[n]=$drv
    if [ "$drv" = 1 ]; then M_STATE[n]=DRIVERS
    elif [ -z "$pk" ]; then M_STATE[n]=BUILTIN
    elif [ -z "$missing" ]; then M_STATE[n]=INSTALLED
    elif [ "$CAN_INSTALL" = 1 ]; then M_STATE[n]=MISSING
    else M_STATE[n]=MISSING; fi
    n=$((n + 1))
  done < "$MAP"
  N=$n
}

print_check() {
  local i st
  say "Software for the hardware in this computer (profile: $PROFILE). Check only: nothing is installed."
  say ""
  for ((i = 0; i < N; i++)); do
    case "${M_STATE[i]}" in
      INSTALLED) st="[OK]     " ;; MISSING) st="[MISSING]" ;; BUILTIN) st="[OK]     " ;; DRIVERS) st="[DRIVERS]" ;;
    esac
    printf '%s %-16s %s (%s)\n' "$st" "${M_ID[i]}" "${M_TITLE[i]}" "${M_LABEL[i]}"
    case "${M_STATE[i]}" in
      INSTALLED) say "            Installed: ${M_PKGS[i]}" ;;
      BUILTIN) say "            Built into Linux: nothing to install. ${M_WHY[i]}" ;;
      MISSING) say "            Missing: ${M_MISSING[i]}"; say "            ${M_WHY[i]}" ;;
      DRIVERS) say "            ${M_WHY[i]}  Run: sudo secure-linux-drivers install" ;;
    esac
  done
  local any=0; for ((i = 0; i < N; i++)); do [ "${M_STATE[i]}" = MISSING ] && any=1; done
  say ""
  if [ "$any" = 1 ]; then
    if [ "$CAN_INSTALL" = 1 ]; then say "To install what is missing: sudo secure-linux-parts --install"
    else say "$WHY_NOT"; if [ "$PROFILE" = atomic ]; then say "Command: rpm-ostree install $(all_missing)   (then restart)"; fi; fi
  else say "Everything needed for the hardware found here is already installed."; fi
}
all_missing() { local i; for ((i = 0; i < N; i++)); do [ "${M_STATE[i]}" = MISSING ] && printf '%s\n' ${M_MISSING[i]}; done | awk '!s[$0]++' | tr '\n' ' '; }
print_json() {
  local i first=1
  printf '{\n  "tool": "secure-linux-parts",\n  "profile": "%s",\n  "can_install": %s,\n  "note": "%s",\n  "devices": [\n' "$PROFILE" "$( [ "$CAN_INSTALL" = 1 ] && echo true || echo false )" "$(slh_esc "$WHY_NOT")"
  for ((i = 0; i < N; i++)); do
    [ $first = 1 ] || printf ',\n'; first=0
    printf '    {"id": "%s", "title": "%s", "device": "%s", "state": "%s", "packages": "%s", "missing": "%s", "why": "%s"}' \
      "$(slh_esc "${M_ID[i]}")" "$(slh_esc "${M_TITLE[i]}")" "$(slh_esc "${M_LABEL[i]}")" "${M_STATE[i]}" "$(slh_esc "${M_PKGS[i]}")" "$(slh_esc "${M_MISSING[i]}")" "$(slh_esc "${M_WHY[i]}")"
  done
  printf '\n  ]\n}\n'
}

# ---------------------------------------------------------------- installing
online() {
  case "${SL_PARTS_ONLINE:-}" in yes) return 0 ;; no) return 1 ;; esac
  curl -fsS --max-time 8 -o /dev/null https://mirrors.fedoraproject.org/ 2>/dev/null
}
metered() { have nmcli && nmcli -t -f GENERAL.METERED device show 2>/dev/null | grep -q ':yes'; }
state_dir() { echo "$SL_STATE/parts"; }
record_installed() {   # remember packages (for repair mode) -> parts/installed.list
  local f; f="$(state_dir)/installed.list"; mkdir -p "$(state_dir)" 2>/dev/null || return 0
  { cat "$f" 2>/dev/null; printf '%s\n' "$@"; } | sed '/^$/d' | sort -u > "$f.new" 2>/dev/null && mv -f "$f.new" "$f"
}
do_install() {   # do_install "pkg pkg ..." -> installs (one dnf run), prints a plain result; returns 0 ok, 4 some unavailable, 5 offline
  local pk=$1 p left=""
  [ -n "${pk// /}" ] || return 0
  if ! online; then say "No internet connection right now, so these could not be installed: $pk. They install by themselves when you run 'sudo secure-linux-parts --install' online."; return 5; fi
  say "Installing from Fedora's own repositories: $pk"
  # shellcheck disable=SC2086
  dnf -y install --skip-unavailable $pk
  for p in $pk; do pkg_installed "$p" || left="$left $p"; done
  if [ -n "$left" ]; then say "These are not available for this Fedora release, so they were skipped:${left}. That is not a problem for the other parts."; record_installed $(for p in $pk; do pkg_installed "$p" && echo "$p"; done); return 4; fi
  record_installed $pk
  return 0
}
enable_units() {   # for each matched device: enable its services if the package is there
  local i u
  for ((i = 0; i < N; i++)); do
    [ -n "${M_UNITS[i]}" ] || continue
    [ -z "$(missing_of "$i")" ] || continue
    have systemctl || continue
    for u in ${M_UNITS[i]}; do
      systemctl is-enabled -q "$u" 2>/dev/null || { systemctl cat "$u" >/dev/null 2>&1 && systemctl enable --now "$u" >/dev/null 2>&1 && say "Turned on $u for ${M_TITLE[i]}."; }
    done
  done
}
missing_of() { local m="" p; for p in ${M_PKGS[$1]}; do pkg_installed "$p" || m="$m $p"; done; printf '%s' "${m# }"; }
need_root() { slh_is_root && return 0; have pkexec && exec pkexec "$SELF" "${ORIG_ARGS[@]}"; echo "This needs administrator rights: run it with sudo." >&2; exit 1; }

write_report() {
  local d; d=$(state_dir); mkdir -p "$d" 2>/dev/null || return 0
  print_check > "$d/report.txt" 2>/dev/null
  print_json > "$d/report.json" 2>/dev/null
  printf '%s\n' "$(date '+%Y-%m-%d %H:%M')" > "$d/last-run" 2>/dev/null
}

# ---------------------------------------------------------------- notify the logged-in user
notify_user() {   # notify_user ID "Title" "text"
  local u uid
  slh_event "parts-$1" "$2" "$3" 2>/dev/null
  u=$(cat "$SL_ETC/user" 2>/dev/null)
  if [ -n "$u" ] && uid=$(id -u "$u" 2>/dev/null) && [ -S "/run/user/$uid/bus" ] && have notify-send; then
    if slh_is_root && have runuser; then runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" XDG_RUNTIME_DIR="/run/user/$uid" notify-send -a "Secure Linux" -i preferences-desktop-peripherals "$2" "$3" 2>/dev/null
    else notify-send -a "Secure Linux" -i preferences-desktop-peripherals "$2" "$3" 2>/dev/null; fi
  fi
  say "NOTIFY: $2 - $3"
}

# ---------------------------------------------------------------- actions
case "$ACTION" in
  check)
    scan
    if [ "$JSON" = 1 ]; then print_json; else print_check; fi
    [ "$QUIET" = 1 ] && write_report
    exit 0 ;;

  install)
    need_root
    scan
    [ "$QUIET" = 1 ] || print_check
    if [ "$CAN_INSTALL" = 0 ]; then say ""; say "$WHY_NOT"; write_report; [ "$PROFILE" = atomic ] && say "Command: rpm-ostree install $(all_missing)"; exit 0; fi
    pk=$(all_missing); rc=0
    if [ -n "${pk// /}" ]; then do_install "$pk"; rc=$?; scan; fi
    enable_units
    if [ "$DRIVERS" = 1 ]; then
      for ((i = 0; i < N; i++)); do
        if [ "${M_DRIVERS[i]}" = 1 ]; then drvneeded=1; fi
      done
      if [ "${drvneeded:-0}" = 1 ]; then
        if have secure-linux-drivers; then say "Graphics / Wi-Fi / Mac drivers: running secure-linux-drivers install (this can take several minutes)."; secure-linux-drivers install; else say "secure-linux-drivers is not installed here; skipped the graphics / Wi-Fi drivers."; fi
      fi
    fi
    if [ "$rc" = 5 ]; then slh_alert parts-pending "Software for your hardware is waiting" "Some hardware needs software that could not be downloaded because there was no internet. It installs when you connect and run: secure-linux-parts --install" "Connect to the internet, then run secure-linux-parts --install" 2>/dev/null
    else slh_alert_clear parts-pending; fi
    # remember what is here, so hot-plugging only reports NEW devices
    mkdir -p "$(state_dir)" 2>/dev/null; for ((i = 0; i < N; i++)); do echo "${M_ID[i]}"; done | sort -u > "$(state_dir)/seen" 2>/dev/null
    write_report
    say ""; say "Done."
    exit $rc ;;

  reassert)
    need_root
    scan
    if [ "$CAN_INSTALL" = 0 ]; then say "$WHY_NOT"; exit 0; fi
    lst="$(state_dir)/installed.list"; want=""
    if [ -f "$lst" ]; then
      for p in $(cat "$lst"); do pkg_installed "$p" || want="$want $p"; done
    fi
    if [ -n "${want// /}" ]; then say "Putting back software that went missing:$want"; do_install "${want# }"; fi
    enable_units
    write_report
    exit 0 ;;

  hotplug)
    need_root
    d=$(state_dir); mkdir -p "$d" 2>/dev/null
    if have flock; then exec 9>"$d/hotplug.lock"; flock -n 9 || exit 0; fi
    sleep "${SL_PARTS_SETTLE:-4}"                  # a device announces several interfaces; wait until they are all there
    PCI_LIST=$(slh_pci_list); USB_LIST=$(slh_usb_list); USBIF_LIST=$(slh_usb_ifaces); INPUT_LIST=$(slh_inputs)
    scan
    seen="$d/seen"
    if [ ! -f "$seen" ]; then                      # first run: the install step handles everything present now
      for ((i = 0; i < N; i++)); do echo "${M_ID[i]}"; done | sort -u > "$seen"; exit 0
    fi
    if [ "$(slh_lc "$(cat "$SL_ETC/choices" 2>/dev/null | sed -n 's/^parts_autoinstall=//p' | tail -n1)")" = no ]; then exit 0; fi
    DONE_LIST=()
    for ((i = 0; i < N; i++)); do
      grep -qx "${M_ID[i]}" "$seen" 2>/dev/null && continue
      id=${M_ID[i]}; label=${M_LABEL[i]}; title=${M_TITLE[i]}
      if [ "${M_DRIVERS[i]}" = 1 ]; then
        notify_user "$id" "New device found: $label" "It needs a driver that is installed with a restart. Open a terminal and run: sudo secure-linux-drivers install"
        echo "$id" >> "$seen"; continue
      fi
      if [ -z "${M_MISSING[i]}" ]; then echo "$id" >> "$seen"; [ -n "${M_PKGS[i]}" ] && notify_user "$id" "New device found: $label" "The software to use it ($title) is already installed."; continue; fi
      if [ "$CAN_INSTALL" = 0 ]; then notify_user "$id" "New device found: $label" "$WHY_NOT"; echo "$id" >> "$seen"; continue; fi
      if metered; then notify_user "$id" "New device found: $label" "You are on a metered connection, so the software for it was not downloaded. Run secure-linux-parts --install on Wi-Fi/Ethernet."; continue; fi
      notify_user "$id" "New device found: $label" "Installing software to use it (${M_MISSING[i]})."
      do_install "${M_MISSING[i]}"; rc=$?
      if [ "$rc" = 5 ]; then notify_user "$id-wait" "Software for $label is waiting" "There is no internet right now. It installs the next time you run secure-linux-parts --install while online."; continue; fi
      echo "$id" >> "$seen"; DONE_LIST+=("$id|$title")
    done
    scan; enable_units
    for e in "${DONE_LIST[@]:-}"; do [ -n "$e" ] && notify_user "${e%%|*}-done" "${e#*|} is ready" "You can use it now."; done
    write_report
    exit 0 ;;
esac
