#!/bin/bash
# secure-linux-explain: plain-English help for an error message, and a search of the Secure Linux guide.
#   secure-linux-explain                  explain whatever you last copied (Ctrl+C); asks you to paste it if empty
#   secure-linux-explain "error text"     explain this text
#   some-command 2>&1 | secure-linux-explain -    explain what a command printed
#   secure-linux-explain --search WORDS   search the guide (no AI needed), e.g. --search printer wifi
#   secure-linux-explain --no-ai [TEXT]   skip the AI and search the guide with the words from the error
#   secure-linux-explain --print [TEXT]   print the answer here instead of opening a window
# The AI is "Ollama" running on THIS computer: your error text never leaves it. If Ollama (or a model) isn't
# there, you still get the best matching guide pages. AI answers can be wrong: it says so, and it never
# runs anything for you.
set -uo pipefail
SL_ROOT=${SL_ROOT:-/usr/local/lib/secure-linux}
. "$SL_ROOT/lib/common.sh"
. "$SL_ROOT/files/comfort/comfort-lib.sh"
SELF=$(readlink -f "$0")
usage() { sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'; }
OLLAMA_URL=${OLLAMA_URL:-http://127.0.0.1:11434}
MAX_CHARS=3500

# ---------------------------------------------------------------- where the guide lives
guide_md_dir() {
  local docs; docs=$(xdg-user-dir DOCUMENTS 2>/dev/null); [ -n "$docs" ] && [ "$docs" != "$HOME" ] || docs=$HOME/Documents
  echo "$docs/Secure Linux Guide"
}

# ---------------------------------------------------------------- the text to explain
clipboard() {
  local t=""
  if cf_have wl-paste && [ -n "${WAYLAND_DISPLAY:-}${CF_TEST_CLIPBOARD:-}" ]; then t=$(wl-paste -n 2>/dev/null)
  elif cf_have xclip; then t=$(xclip -o -selection clipboard 2>/dev/null)
  elif cf_have xsel; then t=$(xsel -b 2>/dev/null)
  fi
  if [ -z "$t" ]; then
    for q in qdbus6 qdbus-qt6 qdbus; do
      cf_have "$q" && { t=$($q org.kde.klipper /klipper getClipboardContents 2>/dev/null); [ -n "$t" ] && break; }
    done
  fi
  printf '%s' "$t"
}
tidy_text() {   # no control characters; keep the start and the end of very long text (the cause is usually at the end)
  local t
  t=$(printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037')
  if [ "${#t}" -gt "$MAX_CHARS" ]; then
    t="${t:0:2000}
[... middle left out ...]
${t: -1400}"
  fi
  printf '%s' "$t"
}

# ---------------------------------------------------------------- guide search (works without any AI)
# Plain words (4+ letters, minus filler) from the text; each guide page is scored by how many different
# words it contains, with a bonus when a word is in the page's title.
keywords() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' ' ' | tr -s ' ' '\n' | awk '
    BEGIN { split("this that with from have been were will would could should there their about after before error failed failure cannot unable the and for not you your are was can its into when what which while does did done has had but only some more than then them they also just like over under file files line lines", s, " "); for (i in s) stop[s[i]]=1 }
    length($0) >= 4 && length($0) <= 30 && !($0 in stop) && !seen[$0]++ { print }' | head -12
}
guide_search() {   # guide_search "text"  -> up to 5 lines "Title<TAB>link"
  local words dir
  words=$(keywords "$1")
  [ -n "$words" ] || return 0
  dir=$(guide_md_dir)
  [ -d "$dir" ] || dir=""
  [ -n "$dir" ] || [ -f "$CF_GUIDE" ] || return 0
  # One python process does all the matching (a shell loop over 100+ pages would be slow).
  python3 -I - "$dir" "$CF_GUIDE" $words <<'PY' 2>/dev/null
import html, os, re, sys
mddir, guide, words = sys.argv[1], sys.argv[2], [w.lower() for w in sys.argv[3:]]
BASE = "file:///usr/share/secure-linux/START-HERE.html"
found = []
def clean(t):
    # guide headings start with an emoji (often as &#x1F512;): show plain text only
    t = html.unescape(re.sub(r"<[^>]+>", "", t)).strip()
    return re.sub(r"^[^A-Za-z0-9]+", "", t)
def score(title, text):
    t = title.lower(); x = text.lower()
    return sum((1 if w in x else 0) + (2 if w in t else 0) for w in words)
if mddir:
    # the searchable Markdown copy made at first login (one file per chapter and per app)
    for root, _, files in os.walk(mddir):
        for name in files:
            if not name.endswith(".md") or name.startswith("00 "):
                continue
            try:
                text = open(os.path.join(root, name), encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            m = re.match(r"#\s*(.*)", text)
            title = clean(m.group(1)) if m else name[:-3]
            ident = re.search(r"Full page: \S*#(\S+?)_?\s*$", text, re.M)
            sc = score(title, text)
            if sc:
                found.append((sc, title, BASE + ("#" + ident.group(1) if ident else "")))
elif guide:
    # no Markdown copy yet: look straight into the guide (section ids and headings)
    src = open(guide, encoding="utf-8", errors="replace").read()
    for p in re.split(r'(?=<(?:section|div|article)[^>]*\bid="[^"]+")', src):
        m = re.match(r'<(?:section|div|article)[^>]*\bid="([^"]+)"', p)
        if not m:
            continue
        t = re.search(r"<h[1-3][^>]*>(.*?)</h[1-3]>", p, re.S)
        title = clean(t.group(1)) if t else m.group(1)
        sc = score(title, re.sub(r"<[^>]+>", " ", p))
        if sc:
            found.append((sc, title, BASE + "#" + m.group(1)))
found.sort(key=lambda x: -x[0])
for _, title, link in found[:5]:
    print(title + "\t" + link)
PY
}
guide_section() {   # nicely formatted pages list
  local lines; lines=$(guide_search "$1")
  if [ -z "$lines" ]; then
    echo "I couldn't find a guide page that matches. Open the guide (START-HERE on your Desktop) and use its search box."
    return 0
  fi
  echo "Guide pages that may help:"
  printf '%s\n' "$lines" | while IFS=$'\t' read -r t l; do echo "  - $t"; echo "      $l"; done
}

# ---------------------------------------------------------------- the local AI
ai_up() { curl -fsS --max-time 3 "$OLLAMA_URL/api/version" >/dev/null 2>&1; }
installed_models() { ollama list 2>/dev/null | awk 'NR>1 {print $1}'; }
pick_model() {   # first of the user's chosen models that is installed, else any installed chat model
  local have want m; have=$(installed_models)
  [ -n "$have" ] || return 1
  want=$(sl_choice_get ai_models "qwen2.5-coder:7b,qwen2.5-coder:1.5b")
  for m in ${want//,/ }; do printf '%s\n' "$have" | grep -qx "$m" && { echo "$m"; return 0; }; done
  printf '%s\n' "$have" | grep -v -i 'embed' | head -1
}
ask_ai() {   # ask_ai MODEL "text"  -> the answer, or nothing
  local model=$1 text=$2 body
  body=$(python3 -I - "$model" "$text" <<'PY'
import json, sys
system = ("You help a beginner who has just switched from Windows or Mac to Linux (Fedora). "
          "Explain the error message in plain, calm Australian English, in three short parts: "
          "1) What it means, in one or two sentences, with no jargon. "
          "2) The most likely cause. 3) What to try, as at most three small steps, safest first. "
          "Never blame the person. Never tell them to disable the firewall, Secure Boot, SELinux or the disk "
          "encryption. If a step needs a command, say what it does before showing it, and prefer undoable steps. "
          "If you are not sure, say so. Keep it under 200 words.")
print(json.dumps({"model": sys.argv[1], "system": system,
                  "prompt": "Here is the error message:\n\n" + sys.argv[2],
                  "stream": False, "options": {"temperature": 0.2, "num_ctx": 4096}}))
PY
  ) || return 1
  printf '%s' "$body" | curl -fsS --max-time "${CF_AI_TIMEOUT:-240}" -H 'Content-Type: application/json' \
      --data-binary @- "$OLLAMA_URL/api/generate" 2>/dev/null |
    python3 -I -c 'import json,sys
try:
    print(json.load(sys.stdin).get("response","").strip())
except Exception:
    pass'
}

# ---------------------------------------------------------------- showing the answer
show() {   # show "text"
  local f
  if [ -n "$PRINT" ] || { [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ -z "${CF_TEST_GUI:-}" ]; }; then
    printf '%s\n' "$1"; return
  fi
  f=$(mktemp); printf '%s\n' "$1" > "$f"
  if cf_have kdialog; then kdialog --title "Explain This Error" --textbox "$f" 640 480
  elif cf_have zenity; then zenity --text-info --title="Explain This Error" --width=640 --height=480 --filename="$f"
  else cat "$f"; fi
  rm -f "$f"
}

# ---------------------------------------------------------------- main
PRINT=""; NOAI=""; SEARCH=""; TEXT=""; HAVE_TEXT=""
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help|help) usage; exit 0 ;;
    --print) PRINT=1 ;;
    --no-ai) NOAI=1 ;;
    --search) SEARCH=1; shift; TEXT="$*"; HAVE_TEXT=1; break ;;
    -) TEXT=$(cat); HAVE_TEXT=1 ;;
    -*) usage; exit 2 ;;
    *) TEXT="${TEXT:+$TEXT }$1"; HAVE_TEXT=1 ;;
  esac
  shift
done

if [ -n "$SEARCH" ]; then
  [ -n "$TEXT" ] || { echo "Type some words to search for, e.g.: secure-linux-explain --search printer" >&2; exit 2; }
  show "$(guide_section "$TEXT")"
  exit 0
fi

[ -n "$HAVE_TEXT" ] || TEXT=$(clipboard)
if [ -z "${TEXT//[[:space:]]/}" ]; then
  . "$CF_FILES/wz-fallback.sh"; UI_TITLE="Explain This Error"
  TEXT=$(wz_input "Paste the error message here (select it, copy with Ctrl+C, then paste with Ctrl+V):")
  [ -n "${TEXT//[[:space:]]/}" ] || { echo "Nothing to explain. Copy the error message first, then run this again." >&2; exit 1; }
fi
TEXT=$(tidy_text "$TEXT")

ANSWER=""; NOTE=""
if [ -n "$NOAI" ]; then NOTE="(AI switched off for this search.)"
elif ! cf_have ollama; then NOTE="The private AI (Ollama) isn't installed on this computer, so here are the closest guide pages instead."
elif ! ai_up; then NOTE="The private AI isn't running right now (it may still be starting). Here are the closest guide pages instead. Try again in a minute."
else
  MODEL=$(pick_model) || MODEL=""
  if [ -z "$MODEL" ]; then NOTE="The private AI has no model downloaded yet (open 'Secure Linux AI' setup, or run: secure-linux-ai setup). Here are the closest guide pages instead."
  else
    cf_notify "Explain This Error" "Thinking... this can take a minute on a laptop. Nothing leaves this computer."
    ANSWER=$(ask_ai "$MODEL" "$TEXT") || ANSWER=""
    [ -n "$ANSWER" ] || NOTE="The AI didn't give an answer this time. Here are the closest guide pages instead."
  fi
fi

OUT=""
if [ -n "$ANSWER" ]; then
  OUT="$ANSWER

----
This explanation was written by an AI running on this computer. It can be wrong, so don't run anything you don't understand, and ask a person if you're unsure. Your text was not sent anywhere.

$(guide_section "$TEXT")"
else
  OUT="${NOTE:+$NOTE

}$(guide_section "$TEXT")"
fi
show "$OUT"
exit 0
